---
/**
 * Row of partner / supporter logos on white tiles.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	heading?: string;
	intro?: string;
	logos: { src: ImageMetadata; alt: string; tile?: 'white' | 'primary' }[];
	dark?: boolean;
	/** Tile background, for logos that are white-on-transparent */
	tile?: 'white' | 'primary';
}

const { heading, intro, logos, dark = false, tile = 'white' } = Astro.props;
---

<section class:list={['section', 'logo-wall', { 'section--dark': dark }]}>
	<div class="container">
		{heading && <h2 class="text-center">{heading}</h2>}
		{intro && <p class="logo-wall__intro text-center">{intro}</p>}
		<ul class="logo-wall__grid">
			{
				logos.map((l) => (
					<li class:list={{ 'logo-wall__tile--primary': (l.tile ?? tile) === 'primary' }}>
						<Image src={l.src} alt={l.alt} width={320} />
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.logo-wall__intro {
		max-width: 40rem;
		margin: 0 auto 2rem;
	}

	.logo-wall__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	li {
		width: 11rem;
		height: 7rem;
		padding: 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.25rem;
		background: var(--color-white);
		border: 1px solid rgba(95, 125, 215, 0.2);
	}

	.logo-wall__tile--primary {
		background: var(--color-primary);
		border-color: var(--color-primary);
	}

	img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
	}
</style>
