---
/**
 * Grid of photos with optional captions.
 */
import { Image } from 'astro:assets';
import type { Photo } from '../data/library';

interface Props {
	heading?: string;
	intro?: string;
	photos: Photo[];
	/** Alternate section background */
	dark?: boolean;
	/** Show whole image (for posters/graphics) instead of cropping to fill */
	contain?: boolean;
	id?: string;
	class?: string;
	style?: string;
}

const { heading, intro, photos, dark = false, contain = false, id, class: className, style } = Astro.props;
---

<section id={id} class:list={['section', 'photo-gallery', className, { 'section--dark': dark }]} style={style}>
	<div class="container">
		{heading && <h2 class="text-center">{heading}</h2>}
		{intro && <p class="photo-gallery__intro text-center">{intro}</p>}
		<ul class:list={['photo-gallery__grid', { 'photo-gallery__grid--contain': contain, 'photo-gallery__grid--two': photos.length === 2 }]}>
			{
				photos.map((p) => (
					<li>
						<figure>
							<Image src={p.src} alt={p.alt} widths={[400, 800]} sizes="(max-width: 600px) 100vw, 33vw" />
							{p.caption && <figcaption>{p.caption}</figcaption>}
						</figure>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.photo-gallery__intro {
		max-width: 40rem;
		margin: 0 auto 2rem;
	}

	.photo-gallery__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	figure {
		margin: 0;
	}

	img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 0.25rem;
	}

	.photo-gallery__grid--two {
		grid-template-columns: repeat(2, 1fr);
		max-width: 52rem;
		margin: 0 auto;
	}

	.photo-gallery__grid--contain img {
		object-fit: contain;
		background: var(--color-yellow-light);
	}

	figcaption {
		margin-top: 0.4rem;
		font-size: 0.875rem;
	}

	@media (max-width: 991px) {
		.photo-gallery__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
