<style>
	.hhh {
		position: relative;
		padding-bottom: 5rem;
	}

	.hhh__zigzag {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 6px;
		line-height: 0;
	}

	.hhh__zigzag svg {
		width: 100%;
		height: 6px;
	}

	.hhh ul {
		padding-left: 1.25rem;
	}

	.hhh li {
		margin-bottom: 0.75rem;
	}
</style>
