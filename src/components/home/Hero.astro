---

import { urls } from '../../data/urls';
---

<section class="hero section">
	<div class="hero__shape" aria-hidden="true">
		<svg width="100%" height="96" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
			<path
				fill="#5f7dd7"
				d="M0,-2.13162821e-14 C16.6666667,66.6666667 33.3333333,100 50,100 C66.6666667,100 83.3333333,66.6666667 100,-2.13162821e-14 L100,100 L0,100 L0,-2.13162821e-14 Z"
			></path>
		</svg>
	</div>

	<div class="container hero__grid">
		<div class="hero__welcome">
			<div class="hero__welcome-wrap">
				<p class="hero__eyebrow">
					KEEP<br />GIRL<br />GEEKS<br />IN
				</p>
			</div>
		</div>

		<div class="hero__copy">
			<h1 class="hero__headline">
				Women and girls shape the technology that shapes their lives
			</h1>
			<p class="hero__lead">
				Girls who love tech still get pushed out of it. We <strong>keep them in</strong>, and give women and girls
				the power to <strong>build, question and govern</strong> technology.
			</p>
			
			<p class="hero__punch">
				Building is not scrolling.
			</p>

			<div class="hero__ctas">
				<div class="hero__cta">
					<a href={urls.formats} class="btn btn-primary">Work with us</a>
					<p>For governments, corporates and schools</p>
				</div>
				<div class="hero__cta">
					<a href="#programs" class="btn btn-coral">Join a class</a>
					<p>For girl geeks aged 5 and up</p>
				</div>
				
			</div>
		</div>

		<div class="hero__media">
			<div class="hero__video-wrap">
				<iframe
					src="https://www.youtube-nocookie.com/embed/9R4a_NL9prY"
					title="Girl Geek Academy on The Project"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
					loading="lazy"></iframe>
			</div>
			<p class="hero__video-caption">As seen on The Project — Network Ten</p>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-bottom: 7rem;
		/* Yellow + hero-pattern come from sections.css — don’t override */
	}

	.hero__shape {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		line-height: 0;
		z-index: 2;
		pointer-events: none;
	}

	.hero__grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 1.5rem 2.5rem;
		align-items: start;
		position: relative;
		z-index: 1;
	}

	.hero__welcome {
		grid-column: 1;
		grid-row: 1;
	}

	.hero__copy {
		grid-column: 2;
		grid-row: 1 / span 2;
	}

	.hero__media {
		grid-column: 1;
		grid-row: 2;
		align-self: end;
	}

	.hero__welcome-wrap {
		background-image: url('/images/backgrounds/lightning-bolt.png');
		background-position: center center;
		background-repeat: no-repeat;
		background-size: cover;
		margin: 0 0 -2rem;
		padding: 5rem 0 11rem 4rem;
		animation: hero-bolt 6s ease-in-out infinite;
	}

	@keyframes hero-bolt {
		0%,
		100% {
			filter: brightness(1);
			transform: translateY(0);
		}
		50% {
			filter: brightness(1.08);
			transform: translateY(-4px);
		}
	}

	.hero__eyebrow {
		color: var(--color-primary);
		font-family: var(--font-pinata);
		font-weight: 400;
		font-size: clamp(3rem, 8vw, 7rem);
		line-height: 0.85;
		letter-spacing: 0;
		text-align: left;
		margin: 0;
		text-transform: uppercase;
	}

	.hero__headline {
		font-family: var(--font-display);
		font-size: clamp(2.4rem, 5vw, 4.25rem);
		line-height: 0.88;
		margin: 0 0 1rem;
		max-width: 18ch;
	}

	.hero__lead {
		font-size: 1.15rem;
		max-width: 36rem;
	}

	.hero__punch {
		font-family: var(--font-pinata);
		text-transform: uppercase;
		letter-spacing: 0.02em;
		font-size: clamp(1rem, 2vw, 1.25rem);
		line-height: 1.2;
		color: var(--color-coral);
		max-width: 32rem;
	}

	.hero__ctas {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem 1.5rem;
		margin: 2rem 0 0;
		text-align: center;
	}

	.hero__cta--wide {
		grid-column: 1 / -1;
	}

	.hero__cta p {
		margin: 0.5rem 0 0;
		font-size: 0.9rem;
		color: var(--color-coral);
	}

	.hero__cta:nth-child(2) p {
		color: var(--color-pink);
	}

	.hero__cta:nth-child(3) p {
		color: var(--color-primary);
	}

	.hero__video-wrap {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: 0.5rem;
		overflow: hidden;
		background: #000;
		box-shadow: 8px 8px 0 0 var(--color-coral);
		transform: rotate(-1.5deg);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.hero__video-wrap:hover {
		transform: rotate(0deg) translateY(-4px);
		box-shadow: 10px 12px 0 0 var(--color-mint);
	}

	.hero__video-wrap iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.hero__video-caption {
		font-size: 0.9rem;
		margin: 0.85rem 0 0;
		font-family: var(--font-pinata);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-primary);
	}

	@media (max-width: 991px) {
		.hero {
			padding-bottom: 6rem;
		}

		.hero__grid {
			grid-template-columns: 1fr;
		}

		.hero__welcome,
		.hero__copy,
		.hero__media {
			grid-column: 1;
			grid-row: auto;
		}

		.hero__welcome-wrap {
			margin-bottom: 0;
			padding: 3rem 0.5rem 9rem;
		}

		.hero__eyebrow {
			font-size: clamp(2.75rem, 14vw, 5rem);
		}

		.hero__headline {
			max-width: none;
		}

		.hero__ctas {
			grid-template-columns: 1fr;
		}

		.hero__cta--wide {
			grid-column: auto;
		}

		.hero__video-wrap {
			transform: none;
		}
	}
</style>
