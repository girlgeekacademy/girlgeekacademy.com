---
import { Image } from 'astro:assets';
import reportCover from '../../assets/home/report-cover.jpg';
import { urls } from '../../data/urls';
---

<section class="report section report--white">
	<div class="container grid-2">
		<div class="report__content">
			<div class="report__typed">
				<h2 class="report__fix">
					<span class="report__fix-prefix">FIX THE </span>
					<span id="typed-words" class="report__fix-words" aria-live="polite"></span>
				</h2>
			</div>
			<h2 class="report__title">
				FIX THE SYSTEM,<span class="report__title-accent">NOT THE GIRLS</span>
			</h2>
			<p>
				Gender equity in tech isn’t going backwards for lack of reviews. It’s going backwards for lack of
				<strong>investment in what already works.</strong>
			</p>
			<p>
				We surveyed 302 women, men and non-binary people in tech for the national Diversity in STEM Review.
				In March 2025 the government said it would accept all 11 of the review’s recommendations. Its
				statement eight months later had no national strategy and no advisory council.
			</p>
			<p>
				Girl Geeks say: <strong>Enough talk.</strong> Time for action <strong
					>backed by investment.</strong
				>
			</p>
			<a href={urls.report} class="btn btn-accent">
				READ THE REPORT!
			</a>
		</div>
		<div class="report__image hide-mobile">
			<a href={urls.report}>
				<Image
					src={reportCover}
					alt="Girl Geek Academy STEM report"
					width={724}
					height={1024}
					class="report__cover"
				/>
			</a>
		</div>
	</div>
</section>

<script>
	const words = ['VIOLENCE', 'CAREER PATHS', 'ROLE-MODELLING', 'FUNDING', 'BACKLASH'];
	const el = document.getElementById('typed-words');
	if (el) {
		let wordIndex = 0;
		let charIndex = 0;
		let deleting = false;

		const tick = () => {
			const word = words[wordIndex];
			if (!deleting) {
				el.textContent = word.substring(0, charIndex + 1);
				charIndex++;
				if (charIndex === word.length) {
					deleting = true;
					setTimeout(tick, 2000);
					return;
				}
			} else {
				el.textContent = word.substring(0, charIndex - 1);
				charIndex--;
				if (charIndex === 0) {
					deleting = false;
					wordIndex = (wordIndex + 1) % words.length;
				}
			}
			setTimeout(tick, deleting ? 40 : 65);
		};

		tick();
	}
</script>

<style>
	.report__fix {
		font-family: var(--font-display);
		font-size: clamp(2rem, 6vw, 5rem);
		line-height: 1.15;
		margin-bottom: 0.5rem;
	}

	.report__fix-prefix {
		color: var(--color-accent);
	}

	.report__fix-words {
		color: var(--color-accent);
		border-right: 3px solid var(--color-accent);
		padding-right: 4px;
		animation: report-cursor 0.8s step-end infinite;
	}

	@keyframes report-cursor {
		50% {
			border-color: transparent;
		}
	}

	.report__title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 5rem);
		line-height: 1.15;
		color: var(--color-primary);
		margin-bottom: 1.5rem;
	}

	.report__title-accent {
		color: var(--color-coral);
	}

	.report__cover {
		border-radius: 0.5rem;
		box-shadow: 10px 10px 0 0 var(--color-coral);
		transform: rotate(2deg);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.report__image a:hover .report__cover {
		transform: rotate(0deg) translateY(-6px);
		box-shadow: 12px 14px 0 0 var(--color-yellow);
	}

	.btn-accent {
		background-color: var(--color-yellow);
		border-color: var(--color-yellow);
		color: var(--color-primary);
		box-shadow: 5px 5px 0 0 #f4d5e7;
	}

	.btn-accent:hover {
		background-color: var(--color-yellow-light);
		border-color: var(--color-yellow-light);
		color: var(--color-primary);
	}
</style>
