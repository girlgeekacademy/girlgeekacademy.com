---
import { Image } from 'astro:assets';
import missMakesCode from '../../assets/home/miss-makes-code.png';
import { urls } from '../../data/urls';

const quotes = [
	{
		text: "After seeking venture capital I was advised by Girl Geek Academy to go back to my community. Where I'd started. We have just raised $3 million, breaking the Australian record for a Crowd Equity Raise",
		author: 'George McEncroe',
		role: 'Shebah Founder',
	},
	{
		text: 'What a wonderful day you planned for yesterday. The Little Misses were so engaged, happy and learning without fear and really enjoying the experience. It was a delight to be there and so inspiring to see.',
		author: 'Karin Morrison',
		role: 'Keynote Speaker, Harvard — #missmakescode',
		icon: missMakesCode,
	},
];
---

<section class="testimonials section">
	<div class="testimonials__pattern" aria-hidden="true"></div>
	<div class="container">
		<div class="testimonials__layout">
			<blockquote class="testimonials__quote">
				<p>&ldquo;{quotes[0].text}&rdquo;</p>
				<footer>
					<cite>{quotes[0].author}</cite>
					<span>{quotes[0].role}</span>
				</footer>
			</blockquote>

			<div class="testimonials__center">
				<img
					src="/images/helping-rainbow.png"
					alt="Helping women build the internet"
					width={600}
					height={559}
					class="testimonials__rainbow"
				/>
			</div>

			<blockquote class="testimonials__quote">
				<p>&ldquo;{quotes[1].text}&rdquo;</p>
				<footer>
					<cite>{quotes[1].author}</cite>
					<span>{quotes[1].role}</span>
				</footer>
				{
					quotes[1].icon && (
						<Image
							src={quotes[1].icon}
							alt=""
							width={80}
							height={60}
							class="testimonials__icon"
						/>
					)
				}
			</blockquote>
		</div>

		<div class="testimonials__cta text-center">
			<a href={urls.email} class="btn btn-salmon">Sound good? Get in touch!</a>
		</div>
	</div>
</section>

<style>
	.testimonials {
		position: relative;
		padding-bottom: 5rem;
	}

	.testimonials__pattern {
		position: absolute;
		inset: 0;
		opacity: 0.3;
		pointer-events: none;
	}

	.testimonials .container {
		position: relative;
		z-index: 1;
	}

	.testimonials__layout {
		display: grid;
		grid-template-columns: 1fr minmax(200px, 320px) 1fr;
		gap: 2rem;
		align-items: center;
	}

	.testimonials__quote {
		margin: 0;
		padding: 1.5rem;
		background: var(--color-white);
		border-radius: 0.5rem;
		box-shadow: 0 4px 16px rgba(95, 125, 215, 0.15);
	}

	.testimonials__quote footer {
		margin-top: 1rem;
		font-size: 0.9rem;
	}

	.testimonials__quote cite {
		font-style: normal;
		font-weight: 600;
		display: block;
	}

	.testimonials__center {
		text-align: center;
	}

	.testimonials__rainbow {
		margin: 0 auto;
		max-width: 100%;
		height: auto;
	}

	.testimonials__icon {
		margin-top: 1rem;
	}

	.testimonials__cta {
		margin-top: 2rem;
	}

	.btn-salmon {
		background-color: var(--color-salmon);
		border-color: var(--color-salmon);
		color: var(--color-white);
		font-size: clamp(1.5rem, 3vw, 2.5rem);
	}

	.btn-salmon:hover {
		background-color: var(--color-yellow-light);
		border-color: var(--color-yellow-light);
		color: var(--color-primary);
	}

	@media (max-width: 991px) {
		.testimonials__layout {
			grid-template-columns: 1fr;
		}

		.testimonials__center {
			order: -1;
		}
	}
</style>
