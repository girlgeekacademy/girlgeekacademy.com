---
const items = [
	{
		number: 1,
		title: 'Classes',
		description: "Let's run Educational Workshops, Classes, Hackathons, Game Jams and more!",
		circleClass: 'what-we-do__circle--blue',
	},
	{
		number: 2,
		title: 'Campaigns',
		description:
			"You're doing something great, we can help you spread the word and get people engaged!",
		circleClass: 'what-we-do__circle--coral',
	},
	{
		number: 3,
		title: 'Collabs',
		description: "Not sure how to make an impact? Let's work together and change the world!",
		circleClass: 'what-we-do__circle--blue',
	},
];
---

<section class="what-we-do section">
	<div class="what-we-do__pattern" aria-hidden="true"></div>
	<div class="container">
		<h2 class="text-center">What we do</h2>
		<div class="what-we-do__grid grid-3">
			{
				items.map((item) => (
					<div class="what-we-do__card text-center">
						<div class:list={['what-we-do__circle', item.circleClass]}>{item.number}</div>
						<h4>{item.title}</h4>
						<p>{item.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.what-we-do {
		position: relative;
	}

	.what-we-do__pattern {
		position: absolute;
		inset: 0;
		opacity: 0.3;
		pointer-events: none;
	}

	.what-we-do .container {
		position: relative;
		z-index: 1;
	}

	.what-we-do h2 {
		margin-bottom: 2.5rem;
	}

	.what-we-do__circle {
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 50%;
		color: var(--color-white);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-body);
		font-size: 1.25rem;
		font-weight: 600;
		margin-bottom: 1rem;
	}

	.what-we-do__circle--blue {
		background: var(--color-primary);
	}

	.what-we-do__circle--coral {
		background: var(--color-coral);
	}

	.what-we-do__card h4 {
		margin-bottom: 0.75rem;
	}
</style>
