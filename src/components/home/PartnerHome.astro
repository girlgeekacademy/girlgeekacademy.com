---
import { Image } from 'astro:assets';
import rainbow from '../../assets/home/community-rainbow.png';
import EmailCta from '../EmailCta.astro';
import Zigzag from '../Zigzag.astro';
import { urls } from '../../data/urls';

const proof = [
	{ label: 'Sunsilk', href: urls.caseSunsilk },
	{ label: 'Microsoft Mondays', href: urls.caseMicrosoft },
	{ label: 'AI High', href: urls.caseAiHigh },
	{ label: 'MissMakesCode impact', href: urls.caseMissMakesCode },
];

const asks = [
	{
		audience: 'Governments',
		title: 'Stop funding reviews. Fund what works.',
		intro: 'Enough talk. Act on the Diversity in STEM Review, and back it with investment in what already works.',
		points: [
			'Multi-year funding for women-led programs',
			'A national action plan with real targets',
			'Diversity conditions on grants and procurement',
		],
		cta: 'Read our submission',
		href: urls.report,
	},
	{
		audience: 'Corporates',
		title: 'Keep your women in tech. They’ll help keep the next generation in.',
		intro: 'The push-out doesn’t stop at school. Women leave tech at every career stage, and the women who stay usually want to stop it happening to the girls coming after them. We build programs that do both.',
		points: [
			'Retain and grow your women, from early career through to executive leadership',
			'Give your people a way to bring girls through, like mentoring at SheHacksSwift, hosting work experience or running MissMakesCode for their daughters',
			'Sponsor programs at the moments girls get pushed out, such as AI High',
		],
		cta: 'Build a program with us',
		href: urls.corporates,
	},
	{
		audience: 'Schools',
		title: 'Keep her in the class.',
		points: [
			'Run digital tech classes even when only a few girls enrol',
						'Bring MissMakesCode or AI High to your students',
			'Check your timetable teaches tech to every student until the end of Year 8, as the curriculum requires',
		],
		cta: 'Bring us to your school',
		href: urls.schools,
	},
	{
		audience: 'Parents and women in tech',
		title: 'Be the reason she stays.',
		points: [
						'Sign her up for SheHacksSwift, in Sydney in January 2027',
			'Mentor or speak at a program',
			'Check her school teaches tech until the end of Year 8, as the curriculum requires',
		],
		cta: 'Get involved',
		href: urls.womenInTech,
	},
];
---

<section class="partner-home section">
	<div class="container partner-home__grid">
		<div class="partner-home__copy">
			<p class="partner-home__kicker">Work with us</p>
			<h2>Let’s work together</h2>
			<p class="partner-home__lead">
				Girls and women don’t simply leave tech. They get pushed out. Here’s how you can help keep
				them in.
			</p>
			<!-- Four audience asks: content only, unstyled. Layout still to design. -->
			<ul class="partner-home__asks">
				{
					asks.map((a) => (
						<li class="partner-home__ask">
							<p class="partner-home__audience">{a.audience}</p>
							<h3>{a.title}</h3>
							{a.intro && <p>{a.intro}</p>}
							<ul>
								{a.points.map((pt) => (
									<li>{pt}</li>
								))}
							</ul>
							<a href={a.href} class="btn btn-primary">
								{a.cta}
							</a>
						</li>
					))
				}
			</ul>
			<div class="partner-home__ctas">
				<EmailCta label="Partner with us for 2027" variant="yellow" />
				
				<a href={urls.workWithUs} class="btn btn-mint">Work with Us</a>
			</div>
			<p class="partner-home__proof-label">See it working:</p>
			<ul class="partner-home__proof">
				{
					proof.map((p) => (
						<li>
							<a href={p.href}>{p.label}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div class="partner-home__art hide-mobile">
			<Image
				src={rainbow}
				alt="Girl Geek Academy community rainbow"
				width={751}
				height={696}
				class="partner-home__rainbow"
			/>
		</div>
	</div>
	<Zigzag fill="#5f7dd7" position="bottom" />
</section>

<style>
	.partner-home {
		position: relative;
		overflow: hidden;
		padding-bottom: 5rem;
		color: var(--color-yellow-light);
		/* pink bg from sections.css */
	}

	.partner-home a {
		color: var(--color-yellow-light);
	}

	.partner-home__grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 2rem;
		align-items: center;
	}

	.partner-home__kicker {
		font-family: var(--font-pinata);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin: 0 0 0.5rem;
		color: var(--color-yellow);
	}

	.partner-home h2,
	.partner-home p {
		color: var(--color-yellow-light);
	}

	.partner-home__lead {
		font-size: 1.15rem;
	}

	.partner-home__ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 1.75rem 0 1.5rem;
	}

	.partner-home__proof {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}

	.partner-home__proof a {
		font-family: var(--font-pinata);
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: 0.95rem;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.partner-home__rainbow {
		width: 100%;
		height: auto;
		filter: drop-shadow(0 12px 0 rgba(95, 125, 215, 0.25));
		animation: partner-spin-soft 8s ease-in-out infinite;
	}

	@keyframes partner-spin-soft {
		0%,
		100% {
			transform: rotate(-3deg) scale(1);
		}
		50% {
			transform: rotate(2deg) scale(1.03);
		}
	}

	@media (max-width: 991px) {
		.partner-home__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
