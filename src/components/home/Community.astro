<style>
	.community {
		position: relative;
		padding-bottom: 5rem;
		color: var(--color-white);
	}

	.community a {
		color: var(--color-white);
	}

	.community h1,
	.community p {
		color: var(--color-yellow-light);
	}

	.community__highlight {
		color: var(--color-yellow-light);
	}

	.community__zigzag {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 6px;
		line-height: 0;
	}

	.community__zigzag svg {
		width: 100%;
		height: 6px;
	}
</style>
