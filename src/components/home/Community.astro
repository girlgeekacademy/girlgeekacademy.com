	<div class="container grid-2">
		<div class="hide-mobile">
			<h1>
				<span class="community__highlight">OUR GROWING COMMUNITY </span>
				<span class="community__highlight">CODING FOR GIRLS</span>
			</h1>
			<p>
				Join us for our online classes and coding clubs. These are classes in coding for girls. You
				will make friends and learn new technology together. Form your own computer geek club, meet
				other girls who code! Online each week: same time, same place.
			</p>
			<p><strong>We lift as we climb, together.</strong></p>
			<a href={urls.about} class="btn btn-primary">Learn More About Us</a>
		</div>
		<div>
			<Image
				src={rainbow}
				alt="Women in Tech - Girl Geek Academy - Community Rainbow"
				width={751}
				height={696}
			/>
		</div>
