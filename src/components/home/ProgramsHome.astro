---
import Zigzag from '../Zigzag.astro';
import { programsNav } from '../../data/nav';
import { urls } from '../../data/urls';

const blurbs: Record<string, string> = {
	MissMakesCode: 'Coding confidence for girls 5–8, learning alongside mums and aunties.',
	'AI High': 'Weekly online classes and a community for high school girls who love tech.',
	SheHacks: 'The world’s longest-running hackathon series for women and non-binary folk.',
	SheHacksSwift: 'High school girl geeks build real apps in Swift.',
	SheMakesGames: 'Games careers, game jams and Play Party energy.',
	SheMakes: 'Making, 3D printing, wearables — Australia’s first all-women makerfest format.',
	SheFlies: 'Drones, space and aviation — more women in the sky.',
};

const tones = ['yellow', 'mint', 'pink', 'coral', 'yellow', 'mint'] as const;
---

<section id="programs" class="programs-home section">
	<div class="programs-home__grid-bg" aria-hidden="true"></div>
	<div class="container programs-home__inner">
		<p class="programs-home__kicker text-center">Get ya geek on</p>
		<h2 class="text-center">Our programs</h2>
		<p class="text-center programs-home__intro">
			Every program ends with something she made: an app, a game, a startup, and a crew of friends who
			get it.
		</p>
		<ul class="programs-home__grid">
			{
				programsNav.map((p, i) => (
					<li>
						<a class={`programs-home__card programs-home__card--${tones[i % tones.length]}`} href={p.href}>
							<span class="programs-home__name">{p.label}</span>
							<span class="programs-home__blurb">{blurbs[p.label] ?? ''}</span>
							<span class="programs-home__go">Let’s go →</span>
						</a>
					</li>
				))
			}
		</ul>
		<p class="text-center programs-home__formats">
			Bring any program to your school or workplace, as a workshop, a weekend, a week or an ongoing
			community.
			<a href={urls.formats}>See formats →</a>
		</p>
	</div>
	<Zigzag fill="#ffffff" position="bottom" />
</section>

<style>
	.programs-home {
		position: relative;
		overflow: hidden;
		padding-bottom: 5rem;
		background-color: #fff;
	}

	.programs-home__grid-bg {
		position: absolute;
		inset: 0;
		background-image: url('/images/backgrounds/grid-background.png');
		background-repeat: repeat;
		opacity: 0.85;
		pointer-events: none;
	}

	.programs-home__inner {
		position: relative;
		z-index: 1;
	}

	.programs-home__kicker {
		font-family: var(--font-pinata);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-coral);
		margin: 0 0 0.35rem;
		font-size: clamp(1.25rem, 3vw, 2rem);
	}

	.programs-home__intro {
		max-width: 40rem;
		margin: 0 auto 2.25rem;
		font-size: 1.1rem;
	}

	.programs-home__grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.programs-home__card {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1.5rem 1.35rem 1.25rem;
		border-radius: 0.35rem;
		color: var(--color-primary);
		height: 100%;
		box-shadow: 6px 6px 0 0 var(--color-primary);
		transform: rotate(-1deg);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.programs-home__card:nth-child(even),
	.programs-home__grid > li:nth-child(even) .programs-home__card {
		transform: rotate(1deg);
	}

	.programs-home__card:hover {
		transform: rotate(0deg) translateY(-6px) scale(1.02);
		box-shadow: 8px 12px 0 0 var(--color-primary);
		color: var(--color-primary);
	}

	.programs-home__card--yellow {
		background: var(--color-yellow);
	}
	.programs-home__card--mint {
		background: var(--color-mint);
	}
	.programs-home__card--pink {
		background: var(--color-pink);
	}
	.programs-home__card--coral {
		background: var(--color-coral);
		color: var(--color-white);
	}

	.programs-home__card--coral:hover {
		color: var(--color-white);
	}

	.programs-home__name {
		font-family: var(--font-pinata);
		text-transform: uppercase;
		letter-spacing: 0.03em;
		font-size: clamp(1.15rem, 2.5vw, 1.55rem);
		line-height: 1.1;
	}

	.programs-home__blurb {
		font-size: 0.98rem;
		flex: 1;
	}

	.programs-home__go {
		font-family: var(--font-display);
		font-size: 1.35rem;
		margin-top: 0.25rem;
	}

	.programs-home__formats {
		margin: 2.5rem auto 0;
		max-width: 36rem;
		font-weight: 600;
	}

	.programs-home__formats a {
		color: var(--color-coral);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	@media (max-width: 991px) {
		.programs-home__grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 575px) {
		.programs-home__grid {
			grid-template-columns: 1fr;
		}

		.programs-home__card,
		.programs-home__grid > li:nth-child(even) .programs-home__card {
			transform: none;
		}
	}
</style>
