<style>
	.ai-high {
		position: relative;
		padding-bottom: 2rem;
	}

	.ai-high__content {
		padding-top: 1rem;
		padding-bottom: 1rem;
	}

	.ai-high h2 {
		color: var(--color-white);
	}

	.ai-high__media {
		text-align: center;
	}

	.ai-high__img {
		width: 100%;
		max-width: 700px;
		margin: 0 auto;
		border-radius: 0.5rem;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
	}

	.ai-high__zigzag {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		line-height: 0;
		width: 100%;
	}

	.ai-high__zigzag--bottom {
		margin-bottom: -1px;
	}

	.ai-high__zigzag svg {
		width: 100%;
		height: 18px;
		display: block;
	}

	.ai-high__zigzag--bottom svg path {
		fill: #fff;
	}

	.btn-accent {
		background-color: var(--color-yellow);
		border-color: var(--color-yellow);
		color: var(--color-primary);
		box-shadow: 5px 5px 0 0 #f4d5e7;
	}

	.btn-accent:hover {
		background-color: var(--color-yellow-light);
		border-color: var(--color-yellow-light);
		color: var(--color-primary);
	}
</style>
