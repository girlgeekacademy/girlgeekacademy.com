---
import { Image } from 'astro:assets';
import telstraBanner from '../../assets/home/telstra-banner.png';
import aiHighImage from '../../assets/home/ai-high.jpg';
import { urls } from '../../data/urls';
---

<section class="ai-high section section--dark" id="home-classes">
