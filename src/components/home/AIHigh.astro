---
import { Image } from 'astro:assets';
import telstraBanner from '../../assets/home/telstra-banner.png';
import aiHighImage from '../../assets/home/ai-high.jpg';
import { urls } from '../../data/urls';
---

<section class="ai-high section section--dark" id="home-classes">
	<div class="container grid-2">
		<div class="text-center">
			<h2>AI HigH 2025</h2>
			<p>Girl Geek Academy has recently announced a new program sponsored by the Telstra Foundation.</p>
			<Image src={telstraBanner} alt="Telstra Foundation x Girl Geek Academy" width={800} height={123} />
			<a href={urls.aiHigh} class="btn btn-primary">Learn More!</a>
		</div>
		<div class="hide-mobile">
			<a href={urls.aiHigh}>
				<Image src={aiHighImage} alt="AI High program" width={1200} height={675} class="ai-high__img" />
			</a>
		</div>
	</div>
</section>

<style>
	.ai-high h2 {
		color: var(--color-white);
	}

	.ai-high__img {
		border-radius: 0.5rem;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
	}
</style>
