---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailCta from '../components/EmailCta.astro';
import VideoGallery from '../components/VideoGallery.astro';
import { Image } from 'astro:assets';
import vennDiagram from '../assets/home/venn-diagram.png';
import { sheHacksVideos } from '../data/videos';
import PhotoGallery from '../components/PhotoGallery.astro';
import { lib, photo } from '../data/library';

const roles = [
	{
		name: 'Hackers',
		badge: lib('logos/GGA-Hacker-1.png'),
		description:
			'Provide coding and technical skills to build the minimum viable product. Developers, engineers, and makers.',
		colour: 'role--blue',
	},
	{
		name: 'Hipsters',
		badge: lib('logos/GGA-Hipster.png'),
		description:
			'Handle design, visual experience, and user research. Designers, UX specialists, and creative thinkers.',
		colour: 'role--coral',
	},
	{
		name: 'Hustlers',
		badge: lib('logos/GGA-Hustler.png'),
		description:
			'Manage project coordination, business model, and pitch. Organisers, marketers, and strategists.',
		colour: 'role--mint',
	},
];

const quotes: { text: string; attribution: string; source: string; href?: string }[] = [
	{
		text: 'What the hackathon did was give me a place to see [Bron] for who she was, in her element.',
		attribution: 'Jen Fein, who met her YouLi co-founder Bron Thulke at #SheHacks 2016',
		source: 'SmartCompany, 2019',
		href: 'https://www.smartcompany.com.au/startupsmart/travel-startup-youli/',
	},
	{
		text: 'No sign or remnants of beer and pizza but fresh fruit, popcorn, cupcakes and a range of teas and beautiful tea cups.',
		attribution: 'Charlotte Petris, #SheHacks 2016 judge',
		source: 'SmartCompany, 2016',
		href: 'https://www.smartcompany.com.au/startupsmart/what-this-entrepreneur-learnt-from-going-to-her-first-ever-hackathon/',
	},
	{
		text: "My first hackathon… I'm in a very talented team… and we're building something really fantastic that I would actually use!",
		attribution: 'Fox Woods, #SheHacks 2014',
		source: 'StartupSmart, 2014',
		href: 'https://www.smartcompany.com.au/startupsmart/australias-first-female-hackathon-proves-a-hit/',
	},
	{
		text: "I'm very excited to be out here in an environment that wants and values not just tech, but also women entrepreneurs.",
		attribution: 'Holly Liu, co-founder of Kabam and #SheHacks Entrepreneur in Residence, 2017',
		source: 'Australian Financial Review',
	},
];

const accessibility = [
	'CART captioning',
	'Childcare services',
	'Dietary accommodations',
	'Gender-neutral bathrooms',
	'Lactation rooms',
	'Travel bursaries',
];
---

<Layout
	title="#SheHacks — Girl Geek Academy"
	description="One of the world's longest-running hackathon series for women and non-binary folk, since 2014."
>
	<Header />
	<main>

		<!-- Hero -->
		<section class="shehacks-hero section">
			<div class="container grid-2">
				<div>
				<p class="page-eyebrow">Australia's First All-Women Hackathon, Since 2014</p>
				<h1>#SheHacks</h1>
				<p class="lead">
					Find your team, build your idea and pitch a working prototype, alongside
					brilliant women and non-binary folk. One of the longest-running women's hackathon series in
					the world.
				</p>
				<div class="hero-ctas">
					<EmailCta label="Register interest" variant="primary" />
					<EmailCta label="Bring SheHacks to your organisation" variant="coral" />
				</div>
				<p class="hero-note">Email hello@girlgeekacademy.com with “SheHacks” in the subject line.</p>
				</div>
				<div class="hero-media">
					<Image src={lib('logos/SheHacksVIC-Icons-blue.png')} alt="Pixel-art girl geeks coding around a giant keyboard" width={420} />
				</div>
			</div>
		</section>

		<!-- Origin story -->
		<section class="section origin-section">
			<div class="container grid-2">
				<div>
					<h2>How it started</h2>
					<p>
						In 2014, five women set out to make International Women's Day different. They organised a
						hackathon with tea, cupcakes, yoga and sunlight instead of the usual dark basement and
						energy drinks. It was Australia's first all-women hackathon — and Girl Geek
						Academy was born from it.
					</p>
					<p>
						SheHacks has been running ever since, in Melbourne, regional Victoria and Vanuatu,
						helping hundreds of women and non-binary people find their team, build their idea and
						launch their startup.
					</p>
				</div>
				<div class="text-center">
					<Image
						src={vennDiagram}
						alt="Hacker, Hustler, Hipster Venn diagram"
						width={460}
						height={430}
					/>
				</div>
			</div>
		</section>

		<section class="section quotes-section">
			<div class="container">
				<h2 class="text-center">What people say about #SheHacks</h2>
				<div class="quotes-grid">
					{
						quotes.map((q) => (
							<blockquote class="quote-card">
								<p>“{q.text}”</p>
								<footer>
									<p class="quote-card__by">{q.attribution}</p>
									{q.href ? (
										<a href={q.href}>{q.source}</a>
									) : (
										<p class="quote-card__source">{q.source}</p>
									)}
								</footer>
							</blockquote>
						))
					}
				</div>
			</div>
		</section>

		<!-- Roles -->
		<section class="section section--dark roles-section">
			<div class="container">
				<h2 class="text-center">Find your role</h2>
				<p class="text-center roles-intro">
					Every team needs three skill sets. Which one are you?
				</p>
				<div class="grid-3 roles-grid">
					{
						roles.map((r) => (
							<div class:list={['role-card', r.colour]}>
								<Image src={r.badge} alt="" width={220} class="role-badge" />
								<h4>{r.name}</h4>
								<p>{r.description}</p>
							</div>
						))
					}
				</div>
				<p class="text-center roles-note">
					Not sure which one you are? Most people are a mix — and that's exactly what makes great
					teams.
				</p>
			</div>
		</section>

		<VideoGallery
			heading="Watch #SheHacks"
			intro="Event films and the hacker / hipster / hustler roles — from weekends that launched startups."
			videos={sheHacksVideos}
		/>

		<PhotoGallery
			heading="#SheHacks in pictures"
			photos={[
				photo('photos/49481682582_a6b673326c_k.jpg', 'A team of five taking part in #SheHacks, in front of a patterned wall'),
				photo('photos/brihammond-girl-geek-academy-she-hacks-sunday-0122-2000px.jpeg', 'Participants hard at work on the Sunday of #SheHacks'),
				photo('photos/28977304673_f8bb9cafaa_b.jpeg', 'A big group of #SheHacks participants with their hands in the air', '#SheHacks 2014'),
				photo('photos/28977327113_cec9d4d568_w.jpg', 'Four women laughing together at a laptop', '#SheHacks 2014'),
				photo('photos/29477966254_1f7d069a48_w.jpg', 'Participants listening to a talk', '#SheHacks 2016'),
				photo('photos/49480858726_93b855fec7_k.jpg', 'Four women at a table with laptops', '#SheHacks 2017'),
				photo('photos/GGA-Thumb-SheHacks-Edit.jpg', 'Participants listening to a speaker'),
				photo('photos/29811519540_0433a0f5f7_k.jpg', 'A #SheHacks group photo', '#SheHacks 2016'),
			]}
		/>

		<PhotoGallery
			heading="#SheHacks Vanuatu"
			intro="Presented with SMARTsistas."
			photos={[
				photo('photos/SheHacks-Vanuatu.jpeg', 'Young women in purple t-shirts at #SheHacks Vanuatu'),
				photo('graphics/Artboard-2.png', 'SMARTsistas present #SheHacks Vanuatu, 7–9 December'),
			]}
			dark
		/>

		<!-- Accessibility -->
		<section class="section access-section">
			<div class="container grid-2">
				<div>
					<h2>An event built for everyone</h2>
					<p>
						We're committed to making SheHacks accessible and welcoming for all. We've offered these
						at past events. Tell us what you need when you register and we'll do our best.
					</p>
					<ul class="access-list">
						{accessibility.map((a) => <li>{a}</li>)}
					</ul>
					<p>
						Need something else? Email hello@girlgeekacademy.com and we'll do our best to
						accommodate you.
					</p>
				</div>
				<div class="eligibility-card">
					<h3>Who is it for?</h3>
					<ul>
						<li>Women and non-binary people</li>
						
						<li>Aged 18+</li>
						<li>Any skill level welcome</li>
					</ul>
					<EmailCta label="Register interest" variant="primary" />
				</div>
			</div>
		</section>

	</main>
	<Footer />
</Layout>

<style>
	.shehacks-hero {
		background-color: var(--color-pink);
		padding-bottom: 4rem;
	}

	.page-eyebrow {
		font-family: var(--font-pinata);
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-primary);
		margin: 0 0 0.5rem;
	}

	.lead {
		font-size: 1.125rem;
		max-width: 60ch;
		margin-bottom: 1.5rem;
		color: var(--color-primary);
	}

		.next-event {
		background: var(--color-white, #fff);
		border-radius: 2px;
		box-shadow: 5px 5px 0 0 var(--color-primary);
		padding: 1rem 1.25rem;
		margin: 0 0 1.5rem;
		max-width: 32rem;
	}

	.next-event p {
		margin: 0;
		color: var(--color-primary-hover);
	}

	.next-event__label {
		font-family: var(--font-pinata);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85rem;
	}

	.next-event__title {
		font-weight: 700;
		font-size: 1.15rem;
	}

	.hero-note {
		font-size: 0.9rem;
		margin: 0.75rem 0 0;
		color: var(--color-primary-hover);
	}

	.hero-ctas {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	/* Origin */
	.origin-section {
		background: var(--color-yellow-light);
	}

	.quotes-section {
		background: var(--color-white);
	}

	.quotes-section h2 {
		margin-bottom: 2rem;
	}

	.quotes-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		align-items: stretch;
	}

	.quote-card {
		margin: 0;
		background: var(--color-yellow-light);
		border-radius: 0.5rem;
		padding: 1.75rem 1.5rem;
	}

	.quote-card p {
		margin: 0 0 1rem;
	}

	.quote-card footer {
		margin: 0;
	}

	.quote-card .quote-card__by,
	.quote-card .quote-card__source {
		margin: 0;
		font-size: 0.95rem;
	}

	.quote-card .quote-card__by {
		margin-bottom: 0.35rem;
	}

	.quote-card a {
		font-size: 0.95rem;
		text-decoration: underline;
	}

	@media (max-width: 991px) {
		.quotes-grid {
			grid-template-columns: 1fr;
		}
	}

	/* Roles */
	.roles-section {
		padding-top: 4rem;
		padding-bottom: 4rem;
	}

	.roles-intro {
		max-width: 48ch;
		margin: 0 auto 2.5rem;
		color: var(--color-white);
		opacity: 0.9;
	}

	.role-card {
		border-radius: 0.5rem;
		padding: 1.75rem 1.5rem;
		text-align: center;
	}

	.role-badge {
		width: 150px;
		height: auto;
		margin: 0 auto 0.75rem;
		padding: 0.75rem;
		background: var(--color-white);
		border-radius: 1rem;
	}

	.funder-logo {
		margin-top: 1rem;
		height: auto;
	}

	.role--blue {
		background: rgba(255, 255, 255, 0.15);
	}
	.role--blue h4, .role--blue p { color: var(--color-white); }

	.role--coral {
		background: var(--color-coral);
	}
	.role--coral h4, .role--coral p { color: var(--color-white); }

	.role--mint {
		background: var(--color-mint);
	}
	.role--mint h4, .role--mint p { color: var(--color-primary); }

	.roles-note {
		color: var(--color-white);
		opacity: 0.85;
		margin-top: 2rem;
		max-width: 52ch;
		margin-left: auto;
		margin-right: auto;
	}

	/* Accessibility */
	.access-section {
		background: var(--color-white);
	}

	.access-list {
		padding-left: 1.25rem;
		margin-bottom: 1.5rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.4rem 1rem;
	}

	.access-list li {
		margin: 0;
	}

	.eligibility-card {
		background: var(--color-yellow-light);
		border-radius: 0.5rem;
		padding: 2rem;
		align-self: start;
	}

	.eligibility-card h3 {
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		margin-bottom: 1rem;
	}

	.eligibility-card ul {
		padding-left: 1.25rem;
		margin-bottom: 1.5rem;
	}

	.eligibility-card li {
		margin-bottom: 0.5rem;
	}

	.btn-coral {
		background-color: var(--color-coral);
		border-color: var(--color-coral);
		color: var(--color-white);
	}
	.btn-coral:hover {
		background-color: var(--color-primary-hover);
		border-color: var(--color-primary-hover);
		color: var(--color-white);
	}
</style>
