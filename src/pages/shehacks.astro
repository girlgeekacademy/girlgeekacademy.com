---
/*
 * #SheHacks. Deliberate 2017 look, signed off October 2026.
 * Franklin Gothic Extra Condensed, navy and lavender. Do not restyle to the site palette.
 * SHOW_EVENT false hides Melbourne, tickets, and "what you need to know".
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailCta from '../components/EmailCta.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import ZigZag from '../components/shehacks/ZigZag.astro';
import { videos } from '../data/videos';
import '../styles/shehacks.css';

import dots from '../assets/shehacks/overlay-dots-painted-soft.png';
import hackerBadge from '../assets/shehacks/shehacks-hacker-badge.svg';
import hipsterBadge from '../assets/shehacks/shehacks-hipster-badge.svg';
import hustlerBadge from '../assets/shehacks/shehacks-hustler-badge.svg';
import nabLogo from '../assets/shehacks/nab-logo.png';
import aglLogo from '../assets/shehacks/agl-logo.png';
import genazzanoLogo from '../assets/shehacks/genazzano-logo.png';

// false after 1 Dec: page goes back to evergreen
const SHOW_EVENT = true;
const TICKETS: {
	hat: string;
	places: number;
	link: string;
	waitlist: string;
	soldOut: boolean;
}[] = [
	{
		hat: 'Hacker',
		places: 20,
		link: 'https://book.stripe.com/fZu5kD2pb79H7BVaEocfK02',
		waitlist:
			'https://docs.google.com/forms/d/e/1FAIpQLSco12E5kDWsfEeJ_OnpxJ0GttDqvZtGzs46huTYZbOOc0LHRA/viewform?usp=pp_url&entry.1129005140=Hacker&entry.1873863139=Waitlist',
		soldOut: false,
	},
	{
		hat: 'Hipster',
		places: 10,
		link: 'https://book.stripe.com/9B6eVd9RD0Lj5tN13OcfK03',
		waitlist:
			'https://docs.google.com/forms/d/e/1FAIpQLSco12E5kDWsfEeJ_OnpxJ0GttDqvZtGzs46huTYZbOOc0LHRA/viewform?usp=pp_url&entry.1129005140=Hipster&entry.1873863139=Waitlist',
		soldOut: false,
	},
	{
		hat: 'Hustler',
		places: 10,
		link: 'https://book.stripe.com/fZu8wPgg13Xv5tN8wgcfK04',
		waitlist:
			'https://docs.google.com/forms/d/e/1FAIpQLSco12E5kDWsfEeJ_OnpxJ0GttDqvZtGzs46huTYZbOOc0LHRA/viewform?usp=pp_url&entry.1129005140=Hustler&entry.1873863139=Waitlist',
		soldOut: false,
	},
];
const MENTOR_LINK = '';
const HOURS = '';

const description = SHOW_EVENT
	? "Australia's first all-women hackathon, since 2014. SheHacks Melbourne: 30 November – 1 December 2026, Telstra Customer Insight Centre."
	: "One of the world's longest-running hackathon series for women and gender-diverse people, since 2014.";

const mentorHref = MENTOR_LINK || 'mailto:hello@girlgeekacademy.com?subject=SheHacks%20mentor';
const orgHref = 'mailto:hello@girlgeekacademy.com?subject=SheHacks%20for%20my%20organisation';
const ticketNote =
	"Includes GST and covers both days. After you pay, you'll fill in a short form about you.";

const ticketLine: Record<string, string> = {
	Hacker: 'You build the working prototype.',
	Hipster: 'You design it.',
	Hustler: 'You shape the idea and pitch it.',
};

const facts: { label: string; value: string }[] = [
	{ label: 'When', value: 'Monday 30 November and Tuesday 1 December 2026' },
	...(HOURS ? [{ label: 'Hours', value: HOURS }] : []),
	{
		label: 'Where',
		value:
			'Telstra Customer Insight Centre, Melbourne. Building entry details come with your confirmation email.',
	},
	{
		label: 'Who',
		value: 'Women and gender-diverse people, including non-binary people, aged 18+',
	},
	{ label: 'Teams', value: "We'll match you into a team on the day" },
	{ label: 'Bring', value: "Your laptop and charger. You'll need them both days." },
	{ label: 'Access', value: 'Tell us what you need when you register' },
];

type StripShot = { src: string; alt: string; width: number; height: number };

const stripRows: { reverse: boolean; shots: StripShot[] }[] = [
	{
		reverse: false,
		shots: [
			{
				src: '/images/shehacks/strip/shehacks-2016-hands-up.webp',
				alt: 'A room of participants with their hands in the air at #SheHacks 2016',
				width: 799,
				height: 533,
			},
			{
				src: '/images/shehacks/strip/shehacks-2014-laptop-laughing.webp',
				alt: 'Four women laughing together over a laptop at #SheHacks 2014',
				width: 800,
				height: 534,
			},
			{
				src: '/images/shehacks/strip/shehacks-2017-trophies.webp',
				alt: '3D-printed #SheHacks 2017 trophies shaped like laptops',
				width: 799,
				height: 533,
			},
			{
				src: '/images/shehacks/strip/shehacks-2016-pitch.webp',
				alt: 'A team pitching their idea at #SheHacks 2016',
				width: 799,
				height: 533,
			},
			{
				src: '/images/shehacks/strip/shehacks-2014-tea-trolley.webp',
				alt: 'Two women by the tea trolley at #SheHacks 2014',
				width: 533,
				height: 799,
			},
			{
				src: '/images/shehacks/strip/shehacks-2017-team-table.webp',
				alt: 'Four women at a table with laptops at #SheHacks 2017',
				width: 799,
				height: 533,
			},
			{
				src: '/images/shehacks/strip/shehacks-2016-cupcakes.webp',
				alt: 'A tray of purple and mint cupcakes at #SheHacks 2016',
				width: 799,
				height: 533,
			},
		],
	},
	{
		reverse: true,
		shots: [
			{
				src: '/images/shehacks/strip/shehacks-2016-hand-raised.webp',
				alt: 'A smiling participant with her hand up at #SheHacks 2016',
				width: 799,
				height: 533,
			},
			{
				src: '/images/shehacks/strip/shehacks-2017-pair-laptop.webp',
				alt: 'Two women working through a problem on a laptop at #SheHacks 2017',
				width: 799,
				height: 533,
			},
			{
				src: '/images/shehacks/strip/shehacks-2014-audience.webp',
				alt: 'A room full of women listening at #SheHacks Melbourne 2014',
				width: 800,
				height: 534,
			},
			{
				src: '/images/shehacks/strip/shehacks-2016-winners.webp',
				alt: 'Five women holding their #SheHacks 2016 trophies',
				width: 799,
				height: 533,
			},
			{
				src: '/images/shehacks/strip/shehacks-2017-sticky-notes.webp',
				alt: 'A team at their laptops beside a wall of sticky notes at #SheHacks 2017',
				width: 799,
				height: 533,
			},
			{
				src: '/images/shehacks/strip/shehacks-2017-team-laptop.webp',
				alt: 'A team of four gathered around one laptop at #SheHacks 2017',
				width: 799,
				height: 533,
			},
		],
	},
];

const ticketByHat = Object.fromEntries(TICKETS.map((ticket) => [ticket.hat, ticket]));

const roles: {
	id: string;
	name: string;
	badge: ImageMetadata;
	badgeAlt: string;
	badgeClass: string;
	panelClass: string;
	description: string;
	line: string;
	video: { id: string; title: string };
	watch: string;
	buy: string;
	mirror?: boolean;
}[] = [
	{
		id: 'hacker',
		name: 'Hacker',
		badge: hackerBadge,
		badgeAlt: 'Hacker badge: a hand-drawn laptop',
		badgeClass: 'sh-role-badge sh-role-badge--hacker',
		panelClass: 'sh-ticket-badge sh-ticket-badge--hacker',
		description:
			'Build the working prototype with code, APIs and AI tools. Developers, engineers, and makers.',
		line: ticketLine.Hacker,
		video: videos.sheHacksHacker,
		watch: 'Watch Hacker — #SheHacks',
		buy: 'Buy a hacker ticket',
	},
	{
		id: 'hipster',
		name: 'Hipster',
		badge: hipsterBadge,
		badgeAlt: 'Hipster badge: a hand-drawn pen nib',
		badgeClass: 'sh-role-badge sh-role-badge--hipster',
		panelClass: 'sh-ticket-badge sh-ticket-badge--hipster',
		description:
			'Handle design, visual experience, and user research. Designers, UX specialists, and creative thinkers.',
		line: ticketLine.Hipster,
		video: videos.sheHacksHipster,
		watch: 'Watch Hipster — #SheHacks',
		buy: 'Buy a hipster ticket',
		mirror: true,
	},
	{
		id: 'hustler',
		name: 'Hustler',
		badge: hustlerBadge,
		badgeAlt: 'Hustler badge: a hand-drawn lightbulb',
		badgeClass: 'sh-role-badge sh-role-badge--hustler',
		panelClass: 'sh-ticket-badge sh-ticket-badge--hustler',
		description:
			'Manage project coordination, business model, and pitch. Organisers, marketers, and strategists.',
		line: ticketLine.Hustler,
		video: videos.sheHacksHustler,
		watch: 'Watch Hustler — #SheHacks',
		buy: 'Buy a hustler ticket',
	},
];

const roleBg: Record<string, string> = {
	hacker: 'sh-bg-hacker',
	hipster: 'sh-bg-hipster',
	hustler: 'sh-bg-hustler',
};

const quotes: { text: string; attribution: string; source: string; href?: string }[] = [
	{
		text: 'What the hackathon did was give me a place to see [Bron] for who she was, in her element.',
		attribution: 'Jen Fein, who met her YouLi co-founder Bron Thulke at #SheHacks 2016',
		source: 'SmartCompany, 2019',
		href: 'https://www.smartcompany.com.au/startupsmart/travel-startup-youli/',
	},
	{
		text: 'No sign or remnants of beer and pizza but fresh fruit, popcorn, cupcakes and a range of teas and beautiful tea cups.',
		attribution: 'Charlotte Petris, #SheHacks 2016 judge',
		source: 'SmartCompany, 2016',
		href: 'https://www.smartcompany.com.au/startupsmart/what-this-entrepreneur-learnt-from-going-to-her-first-ever-hackathon/',
	},
	{
		text: "My first hackathon… I'm in a very talented team… and we're building something really fantastic that I would actually use!",
		attribution: 'Fox Woods, #SheHacks 2014',
		source: 'StartupSmart, 2014',
		href: 'https://www.smartcompany.com.au/startupsmart/australias-first-female-hackathon-proves-a-hit/',
	},
	{
		text: "I'm very excited to be out here in an environment that wants and values not just tech, but also women entrepreneurs.",
		attribution: 'Holly Liu, co-founder of Kabam and #SheHacks Entrepreneur in Residence, 2017',
		source: 'Australian Financial Review',
	},
];

const accessibility = [
	{ label: 'CART captioning', tint: 'sh-tint-blush' },
	{ label: 'Childcare services', tint: 'sh-tint-hacker' },
	{ label: 'Dietary accommodations', tint: 'sh-tint-hustler' },
	{ label: 'Gender-neutral bathrooms', tint: 'sh-tint-blush' },
	{ label: 'Lactation rooms', tint: 'sh-tint-hacker' },
	{ label: 'Travel bursaries', tint: 'sh-tint-hustler' },
];

const logos = [
	{ src: nabLogo, alt: 'NAB', class: 'sh-logo sh-logo--nab' },
	{ src: aglLogo, alt: 'AGL', class: 'sh-logo sh-logo--agl' },
	{ src: genazzanoLogo, alt: 'Genazzano FCJ College', class: 'sh-logo sh-logo--genazzano' },
];
---

<Layout
	title="#SheHacks — Girl Geek Academy"
	description={description}
	socialImage="/images/shehacks/og-shehacks.jpg"
>
	<Header />
	<main class="sh-page" style={`--sh-dots: url("${dots.src}")`}>
		<section class="sh-bg-hero">
			<div class="sh-wrap sh-hero-grid">
				<div class="sh-hero-copy">
					<p class="sh-eyebrow">
						The longest-running all-women hackathon series in the world
					</p>
					<h1>
						#SheHacks<span class="sh-tm">™</span>
					</h1>
					<p class="sh-lead">
						Find your team, build your idea and pitch a working prototype, alongside brilliant women
						and gender-diverse people. One of the longest-running women's hackathon series in the world.
					</p>
					{
						SHOW_EVENT && (
							<p class="sh-event">
								<span>SheHacks Melbourne</span>
								<span aria-hidden="true">·</span>
								<span>Monday 30 November and Tuesday 1 December 2026</span>
							</p>
						)
					}
					<div>
						{
							SHOW_EVENT ? (
								<a class="sh-btn sh-btn--navy" href="#tickets">
									Get your ticket
								</a>
							) : (
								<EmailCta label="Register interest" class="sh-btn sh-btn--navy" />
							)
						}
					</div>
					{
						!SHOW_EVENT && (
							<p class="sh-hero-note">
								Email hello@girlgeekacademy.com with “SheHacks” in the subject line.
							</p>
						)
					}
				</div>
				<div class="sh-hero-media">
					<div class="sh-hero-stage">
						<div class="sh-hero-frame">
							<LiteYouTube
								id={videos.sheHacks2016.id}
								title={videos.sheHacks2016.title}
								label="Watch the #SheHacks 2016 film"
								eager
							/>
						</div>
						<Image src={hackerBadge} alt="" class="sh-float sh-float--hacker" />
						<Image src={hipsterBadge} alt="" class="sh-float sh-float--hipster" />
						<Image src={hustlerBadge} alt="" class="sh-float sh-float--hustler" />
					</div>
					<p class="sh-hero-caption">Watch: what happens at #SheHacks</p>
				</div>
			</div>
		</section>

		{
			SHOW_EVENT && (
				<section id="melbourne-2026" class="sh-bg-navy">
					<ZigZag position="top" />
					<div class="sh-wrap sh-melbourne">
						<div class="sh-melbourne-head">
							<h2 class="sh-title">SheHacks Melbourne</h2>
							<p class="sh-when">Monday 30 November and Tuesday 1 December 2026</p>
							<p class="sh-place">Telstra Customer Insight Centre, Melbourne</p>
						</div>
						<p class="sh-emph">This SheHacks we're centring tech-facilitated gender-based abuse.</p>
						<div class="sh-days">
							<article class="sh-day">
								<h3>Day 1: Make friends, build prototypes</h3>
								<p>
									You'll be matched into a team of hackers, hustlers and hipsters. Within an hour you've
									found the thing you all care about. Then your team decides what you can build together
									in a short time frame to prototype a solution. AI Ally, a University of Melbourne
									research project funded by the eSafety Commissioner, will lead the way by sharing what's
									possible.
								</p>
							</article>
							<article class="sh-day">
								<h3>Day 2: Pitch your prototype</h3>
								<p>
									Join us for a cuppa and hear what the teams have built. The AI Ally team showcase what
									they've built, and SheHacks teams pitch to guests from industry, research and the
									prevention sector.
								</p>
							</article>
						</div>
						<p class="sh-close">Places are limited so get in quick!</p>
					</div>
					<ZigZag position="bottom" />
				</section>
			)
		}

		<section id="roles" class="sh-bg-pink">
			<div class="sh-strips" aria-label="Photos from past #SheHacks events">
				{
					stripRows.map((row) => (
						<div class="sh-strip">
							<div class:list={['sh-track', row.reverse && 'sh-track--rev']}>
								{[0, 1].map((copy) =>
									row.shots.map((shot) => (
										<img
											class="sh-shot"
											src={shot.src}
											alt={copy === 0 ? shot.alt : ''}
											width={shot.width}
											height={shot.height}
											aria-hidden={copy === 1 ? 'true' : undefined}
											loading="lazy"
											decoding="async"
										/>
									)),
								)}
							</div>
						</div>
					))
				}
			</div>
			<div class="sh-wrap sh-roles-intro">
				<h2 class="sh-title sh-title--roles">Find your role</h2>
				<p>Every team needs three skill sets. Which one are you?</p>
				<nav class="sh-jumps" aria-label="Jump to a role">
					<a class="sh-jump sh-jump--hacker" href="#hacker">
						<Image src={hackerBadge} alt="" width={40} />
						Hacker
					</a>
					<a class="sh-jump sh-jump--hipster" href="#hipster">
						<Image src={hipsterBadge} alt="" width={34} />
						Hipster
					</a>
					<a class="sh-jump sh-jump--hustler" href="#hustler">
						<Image src={hustlerBadge} alt="" width={28} />
						Hustler
					</a>
				</nav>
				{
					SHOW_EVENT && (
						<p>Tickets are sold by role, so pick the one you'd most like to do.</p>
					)
				}
				<p>
					Not sure which one you are? Most people are a mix — and that's exactly what makes great
					teams.
				</p>
			</div>
		</section>

		{
			roles.map((role) => {
				const ticket = ticketByHat[role.name];
				return (
					<section id={role.id} class={roleBg[role.id]}>
						<div class:list={['sh-wrap', 'sh-role', role.mirror && 'sh-role--mirror']}>
							<div class="sh-role-film">
								<LiteYouTube id={role.video.id} title={role.video.title} label={role.watch} />
							</div>
							<div class="sh-role-copy">
								<Image src={role.badge} alt={role.badgeAlt} class={role.badgeClass} />
								<h2 class="sh-title sh-title--role">{role.name}</h2>
								<p>{role.description}</p>
								<p class="sh-role-line">{role.line}</p>
								{
									SHOW_EVENT && (
										<a
											class="sh-btn sh-btn--navy"
											href={ticket.soldOut ? ticket.waitlist : ticket.link}
										>
											{ticket.soldOut
												? `Join the ${role.name.toLowerCase()} waitlist`
												: role.buy}
										</a>
									)
								}
							</div>
						</div>
					</section>
				);
			})
		}

		{
			SHOW_EVENT && (
				<section class="sh-bg-pink">
					<div class="sh-wrap sh-know-wrap">
						<h2 class="sh-title sh-title--know">What you need to know</h2>
						<dl class="sh-know">
							{facts.map((fact) => (
								<div class="sh-know-row">
									<dt>{fact.label}</dt>
									<dd>{fact.value}</dd>
								</div>
							))}
						</dl>
					</div>
				</section>
			)
		}

		<section class="sh-bg-navy">
			<ZigZag position="top" />
			<div class="sh-wrap sh-who">
				<div class="sh-who-side">
					<h2 class="sh-title sh-title--who">Who is it for?</h2>
					<ul class="sh-who-list">
						<li>Women and gender-diverse people, including non-binary people</li>
						<li>Aged 18+</li>
						<li>Any skill level welcome</li>
					</ul>
					{
						SHOW_EVENT ? (
							<a class="sh-btn sh-btn--blush" href="#tickets">
								Get your ticket
							</a>
						) : (
							<EmailCta label="Register interest" class="sh-btn sh-btn--blush" />
						)
					}
				</div>
				<div class="sh-who-main">
					<h2 class="sh-title sh-title--who">An event built for everyone</h2>
					<p>
						We're committed to making SheHacks accessible and welcoming for all. We've offered these
						at past events. Tell us what you need when you register and we'll do our best.
					</p>
					<ul class="sh-pills">
						{accessibility.map((item) => (
							<li class={item.tint}>{item.label}</li>
						))}
					</ul>
					<p class="sh-fine">
						Need something else? Email <a href="mailto:hello@girlgeekacademy.com">hello@girlgeekacademy.com</a> and we'll do our best to accommodate you.
					</p>
				</div>
			</div>
			<ZigZag position="bottom" />
		</section>

		{
			SHOW_EVENT && (
				<section id="tickets" class="sh-bg-lav">
					<div class="sh-wrap sh-tickets">
						<div class="sh-tickets-head">
							<h2 class="sh-title">Get your ticket</h2>
							<p>
								Every team needs a hacker, a hipster and a hustler, so tickets are sold by hat. Pick the
								one you'd most like to do.
							</p>
						</div>
						<div class="sh-ticket-grid">
							{roles.map((role) => {
								const ticket = ticketByHat[role.name];
								return (
									<article class="sh-ticket">
										<div class={role.panelClass}>
											<Image src={role.badge} alt={role.badgeAlt} />
										</div>
										<div class="sh-ticket-body">
											<div class="sh-ticket-top">
												<h3>{role.name}</h3>
												<p class="sh-price">$20</p>
											</div>
											<p>{role.line}</p>
											<a
												class="sh-btn sh-btn--navy sh-btn--ticket"
												href={ticket.soldOut ? ticket.waitlist : ticket.link}
											>
												{ticket.soldOut
													? `Join the ${role.name.toLowerCase()} waitlist`
													: role.buy}
											</a>
											{!ticket.soldOut && <p class="sh-ticket-note">{ticketNote}</p>}
										</div>
									</article>
								);
							})}
						</div>
					</div>
				</section>
			)
		}

		<section class="sh-bg-started">
			<div class="sh-wrap sh-origin">
				<figure class="sh-origin-photo">
					<img
						src="/images/shehacks/strip/shehacks-2014-audience.webp"
						alt="A room full of women listening at #SheHacks Melbourne 2014"
						width="800"
						height="534"
					/>
					<figcaption>#SheHacks 2014</figcaption>
				</figure>
				<div class="sh-origin-copy">
					<h2 class="sh-title">How it started</h2>
					<p>
						In 2014 we were going to hackathons, but they were usually held in dark basements where they
						fed us beer, pizza and energy drinks. Our mates were always happy we came, but they'd ask
						“why don't more women come?”
					</p>
					<p>
						So we designed a hackathon we actually wanted to go to. We had tea and cupcakes. And yoga.
						And sunlight! We ran the first #SheHacks for International Women's Day 2014. It was
						Australia's first all-women hackathon, and Girl Geek Academy grew out of it.
					</p>
					<p>
						SheHacks has been running ever since, in Melbourne, regional Victoria and Vanuatu, helping
						hundreds of women and non-binary people find their team, build their idea and launch their
						startup.
					</p>
				</div>
			</div>
		</section>

		<section class="sh-bg-lav">
			<div class="sh-wrap sh-quotes">
				<h2 class="sh-title">What people say about #SheHacks</h2>
				<div class="sh-quote-grid">
					{
						quotes.map((quote) => (
							<figure class="sh-quote">
								<span class="sh-quote-mark" aria-hidden="true">
									“
								</span>
								<blockquote>
									<p>{quote.text}</p>
								</blockquote>
								<figcaption>
									{quote.attribution}
									{' · '}
									{quote.href ? <a href={quote.href}>{quote.source}</a> : quote.source}
								</figcaption>
							</figure>
						))
					}
				</div>
			</div>
		</section>

		<section id="organisations" class="sh-bg-navy">
			<ZigZag position="top" />
			<div class="sh-wrap sh-org">
				<div class="sh-org-lead">
					<h2 class="sh-title sh-title--org">Bring SheHacks to your organisation</h2>
					<p>
						We bring a format refined since 2014 that takes teams from idea to working prototype and
						pitch in two days. Hackers, hipsters and hustlers work side by side, so your developers,
						designers and ideas people learn how the others think.
					</p>
				</div>
				<ul class="sh-org-cards">
					<li class="sh-org-card">
						<p class="sh-card-title sh-card-title--blush">Your challenges</p>
						<p>
							Point the teams at the problems you care about. We turn them into briefs that can be built
							and pitched in two days.
						</p>
					</li>
					<li class="sh-org-card sh-org-card--hacker">
						<p class="sh-card-title sh-card-title--hacker">Skills that stay</p>
						<p>
							Staff and students leave having built, designed and pitched something real, and knowing how
							to do it again.
						</p>
					</li>
					<li class="sh-org-card sh-org-card--hustler">
						<p class="sh-card-title sh-card-title--hustler">We run it</p>
						<p>
							Girl Geek Academy has run SheHacks since 2014. We design the event, form the teams and run
							the days with you.
						</p>
					</li>
				</ul>
				<div class="sh-org-logos">
					<p class="sh-company">You'd be in good company</p>
					<p>A few of the workplaces and schools that have brought SheHacks in-house:</p>
					<ul class="sh-logos" aria-label="Past host organisations">
						{
							logos.map((logo) => (
								<li>
									<Image src={logo.src} alt={logo.alt} class={logo.class} />
								</li>
							))
						}
					</ul>
				</div>
				<a class="sh-btn sh-btn--blush" href={orgHref}>Talk to us about your organisation</a>
			</div>
			<ZigZag position="bottom" />
		</section>

		<section class="sh-bg-pink">
			<div class="sh-wrap sh-after">
				<div class="sh-faq">
					<h2 class="sh-title sh-title--faq">FAQ</h2>
					<div class="sh-faq-card">
						<details class="sh-faq-item">
							<summary>What does the ticket cover?</summary>
							<p>Both days of SheHacks Melbourne: Monday 30 November and Tuesday 1 December 2026.</p>
						</details>
						<details class="sh-faq-item">
							<summary>Which ticket should I buy?</summary>
							<p>
								The hat you'd most like to wear for the two days. Most people are a mix, and the form
								asks for your second hat too. See <a href="#roles">Find your role</a> for what each one
								does.
							</p>
						</details>
						<details class="sh-faq-item">
							<summary>Why charge $20?</summary>
							<p>So we can plan seats and food for the people who come.</p>
						</details>
						<details class="sh-faq-item">
							<summary>What if I can't come?</summary>
							<p>
								Tell us by Monday 23 November and we'll refund your ticket. After that, you can pass
								your place to someone else: email <a href="mailto:hello@girlgeekacademy.com">hello@girlgeekacademy.com</a> with their name.
							</p>
						</details>
						<details class="sh-faq-item">
							<summary>Can I come with friends or colleagues?</summary>
							<p>
								Yes, each with your own ticket. Teams are matched on the day, so you'll work with
								people you've just met.
							</p>
						</details>
						<details class="sh-faq-item">
							<summary>Do I need to come both days?</summary>
							<p>Yes. Teams form and build on Monday and pitch on Tuesday.</p>
						</details>
						<details class="sh-faq-item">
							<summary>What should I bring?</summary>
							<p>Your laptop and charger. You'll need them both days.</p>
						</details>
						<details class="sh-faq-item">
							<summary>Can I come to the Day 2 pitches as a guest?</summary>
							<p>
								Day 2 guests come by invitation. To ask about a place, email <a href="mailto:hello@girlgeekacademy.com">hello@girlgeekacademy.com</a>.
							</p>
						</details>
					</div>
				</div>
				<div class="sh-mentor">
					<h2 class="sh-title sh-title--faq">Mentor at SheHacks</h2>
					<div class="sh-mentor-card">
						<p>
							We're looking for mentors for SheHacks Melbourne: developers, designers, product and
							business people, and people from research and the prevention sector. You'll move between
							teams, answer questions and help them get to a working prototype. Mentoring is unpaid.
						</p>
						<a class="sh-btn sh-btn--navy" href={mentorHref}>Become a mentor</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
