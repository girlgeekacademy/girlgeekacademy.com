---
/*
 * SheHacksSwift 2027 landing page.
 * Deliberate one-off look (Swift.org-style painted strokes, gradients, grain, glass),
 * signed off by Sarah, Oct 2026. Do not restyle to the GGA design system.
 * Styles: src/styles/shehacksswift.css · Images: public/images/shehacksswift/
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailCta from '../components/EmailCta.astro';
import { urls } from '../data/urls';
import '../styles/shehacksswift.css';
---

<Layout
	title="SheHacksSwift — Girl Geek Academy"
	description="A free three-day program in Sydney for high school girls and gender-diverse students: learn Swift, build your own app and enter it in the Swift Student Challenge. 12–14 January 2027."
	bodyClass="page-shehacksswift"
>
	<Fragment slot="head">
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
	</Fragment>
	<Header />
	<main>
<div class="shs-root shs-motion shs-grainon shs-dotson" style="font-family: 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif; color: #1B1530; font-size: 18px; line-height: 1.55; background: #ffffff; overflow: clip; position: relative">
<section aria-labelledby="shs-title" class="shs-g shs-dd shs-darkhero" style="position: relative; z-index: 9; background-image: linear-gradient(180deg, #2b2050 0%, #1B1530 30%, #1B1530 calc(100% - 340px), #2b2050 calc(100% - 300px), #4b3773 calc(100% - 240px), #a268c1 calc(100% - 170px), #e4937f calc(100% - 105px), #fdd9a1 calc(100% - 45px), #ffffff 100%); color: #ffffff; padding: clamp(110px, 11vw, 160px) 20px clamp(270px, 24vw, 330px)">
<svg class="shs-hero-art" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMin slice" aria-hidden="true" focusable="false" style="position: absolute; top: 0; left: 0; width: 100%; height: auto; aspect-ratio: 1440 / 900; min-height: 600px; z-index: 1; pointer-events: none"><defs><pattern id="shs-p-lilac" patternUnits="userSpaceOnUse" x="0" y="0" width="1440" height="900"><image href="/images/shehacksswift/stroke-lilac.webp" x="0" y="0" width="1440" height="900"></image></pattern><pattern id="shs-p-white1" patternUnits="userSpaceOnUse" x="0" y="0" width="1440" height="900"><image href="/images/shehacksswift/stroke-white1.webp" x="0" y="0" width="1440" height="900"></image></pattern><pattern id="shs-p-orange_low" patternUnits="userSpaceOnUse" x="0" y="0" width="1440" height="900"><image href="/images/shehacksswift/stroke-orange-low.webp" x="0" y="0" width="1440" height="900"></image></pattern><pattern id="shs-p-orange_top" patternUnits="userSpaceOnUse" x="0" y="0" width="1440" height="900"><image href="/images/shehacksswift/stroke-orange-top.webp" x="0" y="0" width="1440" height="900"></image></pattern><pattern id="shs-p-white2" patternUnits="userSpaceOnUse" x="0" y="0" width="1440" height="900"><image href="/images/shehacksswift/stroke-white2.webp" x="0" y="0" width="1440" height="900"></image></pattern></defs><path class="shs-hero-lilac" d="M -110 760 C 0 740 90 640 90 500 C 90 360 30 200 160 120 C 290 40 420 170 500 250 C 580 330 680 320 740 230 C 800 140 860 90 950 78" fill="none" stroke="url(#shs-p-lilac)" stroke-width="281" stroke-linecap="round" stroke-linejoin="round"></path><path class="shs-hero-white1" d="M -70 880 C 120 850 210 720 200 560 C 190 420 230 300 350 280 C 480 258 540 360 640 350 C 760 338 820 200 960 170 C 1100 140 1200 220 1260 320 C 1300 390 1380 430 1520 430" fill="none" stroke="url(#shs-p-white1)" stroke-width="193" stroke-linecap="round" stroke-linejoin="round"></path><path class="shs-hero-orange_low" d="M 1560 880 C 1440 860 1370 760 1350 640 C 1330 500 1340 340 1230 260 C 1120 180 1000 210 930 160" fill="none" stroke="url(#shs-p-orange_low)" stroke-width="345" stroke-linecap="round" stroke-linejoin="round"></path><path class="shs-hero-orange_top" d="M 700 120 C 820 40 990 20 1130 60 C 1270 100 1370 200 1420 340" fill="none" stroke="url(#shs-p-orange_top)" stroke-width="271" stroke-linecap="round" stroke-linejoin="round"></path><path class="shs-hero-white2" d="M -60 640 C 90 650 160 540 210 430 C 270 300 360 200 520 180 C 660 162 760 200 860 150" fill="none" stroke="url(#shs-p-white2)" stroke-width="106" stroke-linecap="round" stroke-linejoin="round"></path></svg>
<div style="position: relative; z-index: 3; max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: clamp(28px, 3vw, 40px); text-align: center">
<h1 id="shs-title" class="shs-land" style="margin: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 20px 48px; font-family: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif; font-weight: 800; font-size: clamp(50px, 7.4vw, 108px); line-height: 0.96; letter-spacing: -0.035em; color: #ffffff; text-align: left">
<img src="/images/shehacksswift/shehacksswift-logo.webp" alt="SheHacksSwift" width="520" height="481" style="display: block; width: clamp(170px, 19vw, 270px); height: auto">
<span style="display: block">Make friends.<br><span style="color: #C9C3F0">Build apps.</span></span>
</h1>
<div style="display: flex; flex-direction: column; align-items: center; gap: 18px; max-width: 780px">
<p style="margin: 0; font-family: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif; font-weight: 700; font-size: clamp(24px, 2.5vw, 34px); line-height: 1.15; letter-spacing: -0.02em; color: #ffffff; text-wrap: balance">Build your own app in three days.</p>
<p style="margin: 0; font-size: clamp(18px, 1.5vw, 20px); line-height: 1.55; color: #D9D4EA; text-wrap: balance">A free three-day program in Sydney for high school girls and gender-diverse students, including non-binary students. You’ll learn Swift, build your own app with mentors beside you, and leave ready to enter Apple’s <a href="https://developer.apple.com/swift-student-challenge/" target="_blank" rel="noopener noreferrer" style="font-weight: 600; color: #FFD2A3;">Swift Student Challenge</a> in early 2027.</p>
<span class="shs-glass" style="font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace; font-size: 15px; font-weight: 600; color: #ffffff; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.25); padding: 8px 16px; border-radius: 999px">Sydney · 12–14 January 2027</span>
<div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 14px; padding-top: 6px">
<a class="shs-btn" href={urls.sheHacksSwiftRegister} target="_blank" rel="noopener noreferrer" style="display: inline-block; text-decoration: none; font-family: 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif; font-weight: 700; font-size: 21px; line-height: 1.2; padding: 18px 40px; border-radius: 999px; white-space: nowrap; background-image: linear-gradient(135deg, #F05138 0%, #D2342A 100%); color: #ffffff">Sign up</a>
<a class="shs-btn shs-btn-linedark" href="#mentors" style="display: inline-block; text-decoration: none; font-family: 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif; font-weight: 700; font-size: 21px; line-height: 1.2; padding: 18px 40px; border-radius: 999px; white-space: nowrap; border: 2px solid rgba(255, 255, 255, 0.85); padding: 16px 34px; color: #ffffff">Swift developer? Mentor with us</a>
</div>
<p style="margin: 0; max-width: 30em; font-size: 15px; line-height: 1.5; font-weight: 500; color: #CFC3EA">Takes about five minutes. Sign up yourself: a parent or guardian only fills in a form if you’re offered a place.</p>
</div>
<div style="width: 100vw; margin-left: calc(50% - 50vw); display: flex; flex-direction: column; gap: 16px; padding-top: clamp(12px, 2vw, 28px)">
<div class="shs-strip"><div class="shs-track"><img src="/images/shehacksswift/photo-S61.webp" alt="Five students flexing in front of Girl Geek Academy banners" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M43.webp" alt="Four students on a bench, each with her own laptop" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S02.webp" alt="Two students smiling together" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M26.webp" alt="Two students posing in front of a colourful mural" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S66.webp" alt="Two students holding a SheHacksSwift sign" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M65.webp" alt="Three students working on laptops at a table" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S40.webp" alt="Three students posing in front of Girl Geek Academy banners" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S61.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M43.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S02.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M26.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S66.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M65.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S40.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"></div></div>
<div class="shs-strip"><div class="shs-track shs-rev"><img src="/images/shehacksswift/photo-M14.webp" alt="Three students posing and waving" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S13.webp" alt="Two students laughing over a laptop" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M18.webp" alt="Two students with their arms around each other" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S68.webp" alt="Three students holding up signs, one reading SheHacksSwift" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M41.webp" alt="Two students on a bench, each with her own device" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S57.webp" alt="Three students smiling at the camera" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M49.webp" alt="Students holding up their laptops" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M14.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S13.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M18.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S68.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M41.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S57.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M49.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"></div></div>
</div>
</div>
<div class="shs-rib shs-rib1" aria-hidden="true" style="position: absolute; left: -6%; right: -6%; bottom: 0; z-index: 4; pointer-events: none; transform: translateY(50%)"><svg viewBox="0 0 1440 420" focusable="false" style="display: block; width: 100%; height: auto"><defs><pattern id="shs-p-r1" patternUnits="userSpaceOnUse" x="0" y="0" width="1440" height="420"><image href="/images/shehacksswift/ribbon-r1.webp" x="0" y="0" width="1440" height="420"></image></pattern></defs><path class="shs-rib-r1" d="M -120 290 C 160 120 420 360 720 250 C 1000 150 1200 110 1560 230" fill="none" stroke="url(#shs-p-r1)" stroke-width="212" stroke-linecap="round"></path></svg></div>
</section>
<section id="how" aria-labelledby="shs-how" class="shs-g shs-d" style="position: relative; z-index: 7; background-image: linear-gradient(180deg, #ffffff 0%, #e6f6ff 28%, #d9f2ff 62%, #fff3d8 100%); color: #1B1530; padding: clamp(110px, 12vw, 180px) 20px clamp(110px, 12vw, 180px)">
<div style="position: relative; z-index: 3; max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(36px, 4.5vw, 56px)">
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 40px 56px">
<div style="flex: 999 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<h2 id="shs-how" style="margin: 0; font-family: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif; font-weight: 800; font-size: clamp(38px, 5vw, 64px); line-height: 1.0; letter-spacing: -0.03em; text-wrap: balance; text-align: left; color: #1B1530">How it works</h2>
<p style="margin: 0; max-width: 38em; font-size: clamp(19px, 1.6vw, 22px); line-height: 1.5; color: #3B3552">Swift is the programming language used to create apps for Apple devices. You’ll leave with your own app playground: a small, working app that someone can explore in about three minutes. It’s the format the Swift Student Challenge asks for.</p>
<p style="margin: 0; max-width: 38em; font-size: clamp(19px, 1.6vw, 22px); line-height: 1.5; color: #3B3552">Each day follows the steps app designers use: find the problem, build and test, then polish.</p>
</div>
<figure class="shs-glass" style="flex: 1 1 400px; min-width: 0; max-width: 560px; margin: 0; padding: 10px; border-radius: 30px; background: rgba(255, 255, 255, 0.58); border: 1px solid rgba(255, 255, 255, 0.8); box-shadow: 0 1px 2px rgba(60, 30, 20, 0.05), 0 24px 48px -30px rgba(90, 40, 30, 0.45)">
<img src="/images/shehacksswift/photo-M76.webp" alt="A student points at her laptop screen while four others lean in to look" width="1024" height="683" style="display: block; width: 100%; height: auto; border-radius: 22px">
</figure>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(310px, 100%), 1fr)); gap: 20px">
<article class="shs-glass" style="background: rgba(255, 255, 255, 0.58); border: 1px solid rgba(255, 255, 255, 0.8); box-shadow: 0 1px 2px rgba(60, 30, 20, 0.05), 0 24px 48px -30px rgba(90, 40, 30, 0.45); border-radius: 26px; padding: 10px 10px 28px; display: flex; flex-direction: column; gap: 12px">
<img src="/images/shehacksswift/photo-S04.webp" alt="Students chatting and laughing together in a group" width="900" height="600" style="display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 18px; margin-bottom: 8px">
<div style="padding: 0 18px; display: flex; flex-direction: column; gap: 12px">
<span style="align-self: flex-start; font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace; font-size: 14px; font-weight: 600; color: #801a1a; background: rgba(255, 177, 100, 0.9); padding: 5px 12px; border-radius: 999px">Day 1 · Tue 12 Jan</span>
<h3 style="margin: 0; font-family: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif; font-weight: 800; font-size: 30px; line-height: 1.05; letter-spacing: -0.02em">Discover Swift</h3>
<p style="margin: 0; font-size: 17px; line-height: 1.55; color: #3B3552">Meet your crew, get comfortable in Swift and choose the problem your app will solve. Every good app solves a problem for someone. It might be at school, at home, in your community or in something you love doing. Sketch it on paper before you write any code. You’ll also hear from Swift developers about how they got started.</p>
</div>
</article><article class="shs-glass" style="background: rgba(255, 255, 255, 0.58); border: 1px solid rgba(255, 255, 255, 0.8); box-shadow: 0 1px 2px rgba(60, 30, 20, 0.05), 0 24px 48px -30px rgba(90, 40, 30, 0.45); border-radius: 26px; padding: 10px 10px 28px; display: flex; flex-direction: column; gap: 12px">
<img src="/images/shehacksswift/photo-M57.webp" alt="Two students laughing as they look at an app on a laptop" width="900" height="600" style="display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 18px; margin-bottom: 8px">
<div style="padding: 0 18px; display: flex; flex-direction: column; gap: 12px">
<span style="align-self: flex-start; font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace; font-size: 14px; font-weight: 600; color: #801a1a; background: rgba(255, 177, 100, 0.9); padding: 5px 12px; border-radius: 999px">Day 2 · Wed 13 Jan</span>
<h3 style="margin: 0; font-family: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif; font-weight: 800; font-size: 30px; line-height: 1.05; letter-spacing: -0.02em">Build and test</h3>
<p style="margin: 0; font-size: 17px; line-height: 1.55; color: #3B3552">Build your app with mentors on the floor. Add your own drawings, photos, music, sounds and words. Swap with your crew, watch them use it and fix whatever trips them up.</p>
</div>
</article><article class="shs-glass" style="background: rgba(255, 255, 255, 0.58); border: 1px solid rgba(255, 255, 255, 0.8); box-shadow: 0 1px 2px rgba(60, 30, 20, 0.05), 0 24px 48px -30px rgba(90, 40, 30, 0.45); border-radius: 26px; padding: 10px 10px 28px; display: flex; flex-direction: column; gap: 12px">
<img src="/images/shehacksswift/photo-S52.webp" alt="Three students holding up laptops showing their apps" width="900" height="600" style="display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 18px; margin-bottom: 8px">
<div style="padding: 0 18px; display: flex; flex-direction: column; gap: 12px">
<span style="align-self: flex-start; font-family: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace; font-size: 14px; font-weight: 600; color: #801a1a; background: rgba(255, 177, 100, 0.9); padding: 5px 12px; border-radius: 999px">Day 3 · Thu 14 Jan</span>
<h3 style="margin: 0; font-family: 'Bricolage Grotesque', 'Figtree', system-ui, sans-serif; font-weight: 800; font-size: 30px; line-height: 1.05; letter-spacing: -0.02em">App Prep &amp; Celebration</h3>
<p style="margin: 0; font-size: 17px; line-height: 1.55; color: #3B3552">Trim your app so it works in about three minutes and add the finishing touches. Show it at the Day 3 showcase, with feedback from a panel of Swift developers. You’ll leave with your project packaged and ready to submit.</p>
</div>
</article>
</div>
<div class="shs-glass" style="background: rgba(255, 255, 255, 0.58); border: 1px solid rgba(255, 255, 255, 0.8); box-shadow: 0 1px 2px rgba(60, 30, 20, 0.05), 0 24px 48px -30px rgba(90, 40, 30, 0.45); border-radius: 24px; padding: 24px 28px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 24px">
