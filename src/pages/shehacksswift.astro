---
/*
 * SheHacksSwift 2027 landing page.
 * Deliberate one-off look, signed off by Sarah, Oct 2026. Do not restyle to the GGA design system.
 * Piñata LimesSans-Black, Libre Franklin, and Jen Wagner Print.
 * Backgrounds use swift.org's colours (violet at the top) and the painted
 * strokes are swift.org's own watercolour images (Apache 2.0, see
 * public/images/shehacksswift/swift-org/NOTICE.txt).
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailCta from '../components/EmailCta.astro';
import { urls } from '../data/urls';
import '../styles/shehacksswift.css';
---

<Layout
	title="SheHacksSwift — Girl Geek Academy"
	description="A free three-day program in Sydney for high school girls and gender-diverse students: learn Swift, build your own app and enter it in the Swift Student Challenge. 12–14 January 2027."
	bodyClass="page-shehacksswift"
>
	<Header />
	<main>

<style is:global>
	.shs-root.shs-draft :is(h1, h2, h3),
	.shs-root.shs-draft [style*='Piñata'] {
		font-family: 'Piñata LimesSans-Black', sans-serif;
		font-weight: 400;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}
	.shs-draft.shs-dotson .shs-d::after {
		background-image: radial-gradient(rgba(75, 55, 115, 0.12) 1.3px, transparent 1.5px);
	}
	.shs-root.shs-draft .btn.shs-city {
		font-family: 'Jen Wagner Print', sans-serif;
		font-size: 32px;
		font-weight: 400;
		line-height: 0.55;
		letter-spacing: 0;
		text-transform: uppercase;
		padding: 10px 22px;
	}

	.shs-draft .shs-swift-art {
		position: absolute;
		top: calc(-1 * min(9.5vw, 130px));
		left: 0;
		width: 57vw;
		min-width: 500px;
		height: auto;
		aspect-ratio: 1248 / 1116;
		z-index: 1;
		pointer-events: none;
		overflow: visible;
	}
	.shs-draft.shs-root .shs-darkhero .shs-hero-art { opacity: 0.9; }
	.shs-draft .shs-logo {
		display: block;
		width: clamp(170px, 19vw, 270px);
		height: auto;
	}
	.shs-draft .shs-bird-mobile { display: none; }
	@media (max-width: 800px) {
		.shs-draft .shs-swift-art { width: 500px; left: auto; right: 50%; top: 11px; transform: translateX(14%); }
		.shs-draft .shs-mark {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 2px;
			width: 100%;
		}
		.shs-draft .shs-logo { width: 148px; }
		.shs-draft .shs-bird-mobile {
			display: block;
			width: 112px;
			height: auto;
			flex: 0 0 auto;
		}
	}
	.shs-draft .shs-sw { stroke-dasharray: 1000 1300; }
	@keyframes shs-sw-draw { from { stroke-dashoffset: 1150; } to { stroke-dashoffset: 0; } }
	.shs-draft.shs-motion .shs-sw { animation: shs-sw-draw 1000ms cubic-bezier(.55, .05, .68, .6) both; }
	.shs-draft.shs-motion .shs-sw-purple, .shs-draft.shs-motion .shs-sw-white1 { animation-duration: 950ms; }
	.shs-draft.shs-motion .shs-sw-otop { animation-duration: 480ms; animation-delay: 520ms; }
	@keyframes shs-sw-bird { from { opacity: 0; transform: translate(-184.8px, -185.5px); } to { opacity: 1; transform: none; } }
	.shs-draft.shs-motion .shs-sw-bird { animation: shs-sw-bird 200ms cubic-bezier(.2, .8, .4, 1) 750ms both; }
	@media (max-width: 800px) {
		.shs-draft.shs-motion .shs-sw-bird { animation: none; opacity: 0; }
	}
	@keyframes shs-swoop-in { from { opacity: 0; } to { opacity: 1; } }
	@keyframes shs-swart-drift { from { transform: translateX(-3%); } to { transform: translateX(3%); } }
	@media (min-width: 1440px) { .shs-draft .shs-swift-art { width: 820px; min-width: 0; top: -130px; } }
	@supports (animation-timeline: view()) {
		.shs-draft.shs-motion .shs-rib1 .shs-swoop { animation: shs-swoop-in linear both; animation-timeline: --shs-r1; animation-range: entry 0% cover 30%; }
		.shs-draft.shs-motion .shs-rib2 .shs-swoop { animation: shs-swoop-in linear both; animation-timeline: --shs-r2; animation-range: entry 0% cover 30%; }
		.shs-draft .shs-swart-know { view-timeline-name: --shs-a1; }
		.shs-draft .shs-swart-faq { view-timeline-name: --shs-a2; }
		.shs-draft.shs-motion .shs-swart-know .shs-swart-img { animation: shs-swoop-in linear both, shs-swart-drift linear both; animation-timeline: --shs-a1, --shs-a1; animation-range: entry 0% cover 30%, cover 0% cover 100%; }
		.shs-draft.shs-motion .shs-swart-faq .shs-swart-img { animation: shs-swoop-in linear both, shs-swart-drift linear both; animation-timeline: --shs-a2, --shs-a2; animation-range: entry 0% cover 30%, cover 0% cover 100%; }
		.shs-draft.shs-motion .shs-rib3 .shs-swoop { animation: shs-swoop-in linear both; animation-timeline: --shs-r3; animation-range: entry 0% cover 30%; }
	}
</style>
<div class="shs-root shs-draft shs-motion shs-grainon shs-dotson" style="font-family: 'Libre Franklin', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1B1530; font-size: 18px; line-height: 1.55; background: #ffffff; overflow: clip; position: relative">
<section aria-labelledby="shs-title" class="shs-g shs-dd shs-darkhero" style="position: relative; z-index: 9; background-image: linear-gradient(180deg, #a268c1 0%, #6c4a98 16%, #4b3773 34%, #3b2b62 calc(100% - 340px), #4b3773 calc(100% - 300px), #a268c1 calc(100% - 240px), #d48aa6 calc(100% - 170px), #e4937f calc(100% - 105px), #fdd9a1 calc(100% - 45px), #ffffff 100%); color: #ffffff; padding: clamp(110px, 11vw, 160px) 20px clamp(270px, 24vw, 330px)">
<svg class="shs-hero-art shs-swift-art" viewBox="0 0 1248 1116" preserveAspectRatio="xMinYMin meet" aria-hidden="true" focusable="false"><defs><pattern id="shs-sw-purple" patternUnits="userSpaceOnUse" x="-600" y="-600" width="2316" height="2161"><image href="/images/shehacksswift/swift-org/purple-swoop.png" x="600" y="600" width="1116" height="961"></image></pattern><pattern id="shs-sw-white1" patternUnits="userSpaceOnUse" x="-600" y="-600" width="2419" height="2152"><image href="/images/shehacksswift/swift-org/white-swoop-1.png" x="600" y="600" width="1219" height="952"></image></pattern><pattern id="shs-sw-otop" patternUnits="userSpaceOnUse" x="-600" y="-600" width="2420" height="2111"><image href="/images/shehacksswift/swift-org/orange-swoop-top.png" x="600" y="600" width="1220" height="911"></image></pattern><pattern id="shs-sw-obottom" patternUnits="userSpaceOnUse" x="-600" y="-600" width="2420" height="2111"><image href="/images/shehacksswift/swift-org/orange-swoop-bottom.png" x="600" y="600" width="1220" height="911"></image></pattern><pattern id="shs-sw-white2" patternUnits="userSpaceOnUse" x="-600" y="-600" width="2390" height="2034"><image href="/images/shehacksswift/swift-org/white-swoop-2.png" x="600" y="600" width="1190" height="834"></image></pattern></defs><g transform="translate(0 160)"><path class="shs-sw shs-sw-purple" pathLength="1000" d="M-34 860C-34 860 42 912 102 854C162 796 98 658 50 556C2 454 18 48 142 88C272 130 290 678 432 682C574 686 434 102 794 90C1009 83 1028 280 1028 280" fill="none" stroke="url(#shs-sw-purple)" stroke-width="210" stroke-linecap="round" stroke-linejoin="round"></path></g><g transform="translate(-9.5 176)"><path class="shs-sw shs-sw-white1" pathLength="1000" d="M-26 910C-26 910 209 817 90 542C38 422 -87 99 102 62C294 24 226 454 397 650C540 812 530 398 567 228C600 84 764 -94 1182 320" fill="none" stroke="url(#shs-sw-white1)" stroke-width="140" stroke-linecap="round" stroke-linejoin="round"></path></g><g transform="translate(0 24)"><path class="shs-sw shs-sw-otop" pathLength="1000" d="M468 168C468 168 674 46 858 78C1018 106 1116 142 1160 414" fill="none" stroke="url(#shs-sw-otop)" stroke-width="163.4" stroke-linecap="round" stroke-linejoin="round"></path></g><g transform="translate(0 24)"><path class="shs-sw shs-sw-obottom" pathLength="1000" d="M-74 816C-74 816 216 887 326 598C408 382 458 170 634 180C809 190 851 305 904 368C972 448 1124 476 1124 476" fill="none" stroke="url(#shs-sw-obottom)" stroke-width="202.2" stroke-linecap="round" stroke-linejoin="round"></path></g><g transform="translate(-1 91.5)"><path class="shs-sw shs-sw-white2" pathLength="1000" d="M-59 796.5C-59 796.5 258.52 885.51 361 430.5C461 -13.5 757 18.5 903 44.5C1049 70.5 1123 166.5 1167 228.5" fill="none" stroke="url(#shs-sw-white2)" stroke-width="73.6" stroke-linecap="round" stroke-linejoin="round"></path></g><image class="shs-sw-bird" href="/images/shehacksswift/swift-org/bird.png" x="902.5" y="212.5" width="339" height="299"></image></svg>
<div style="position: relative; z-index: 3; max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: clamp(28px, 3vw, 40px); text-align: center">
<h1 id="shs-title" class="shs-land" style="margin: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 20px 48px; font-family: 'Piñata LimesSans-Black', sans-serif; font-weight: 400; font-size: clamp(50px, 7.4vw, 108px); line-height: 0.96; letter-spacing: 0.02em; color: #ffffff; text-align: left; text-transform: uppercase">
<span class="shs-mark"><img class="shs-logo" src="/images/shehacksswift/shehacksswift-logo.webp" alt="SheHacksSwift" width="520" height="481"><img class="shs-bird-mobile" src="/images/shehacksswift/swift-org/bird.png" alt="" width="339" height="299" aria-hidden="true"></span>
<span style="display: block">Make friends.<br><span style="color: #C9C3F0">Build apps.</span></span>
</h1>
<div style="display: flex; flex-direction: column; align-items: center; gap: 18px; max-width: 780px">
<p style="margin: 0; font-family: 'Piñata LimesSans-Black', sans-serif; font-weight: 400; font-size: clamp(24px, 2.5vw, 34px); line-height: 1.15; letter-spacing: 0.02em; color: #ffffff; text-wrap: balance; text-transform: uppercase">Build your own app in three days.</p>
<p style="margin: 0; font-size: clamp(18px, 1.5vw, 20px); line-height: 1.55; color: #D9D4EA; text-wrap: balance">A free three-day program in Sydney for high school girls and gender-diverse students, including non-binary students. You’ll learn Swift, build your own app with mentors beside you, and leave ready to enter Apple’s <a href="https://developer.apple.com/swift-student-challenge/" target="_blank" rel="noopener noreferrer" style="font-weight: 600; color: #FFD2A3;">Swift Student Challenge</a> in early 2027.</p>
<span class="shs-glass" style="font-family: 'Jen Wagner Print', sans-serif; font-size: 52px; font-weight: 400; line-height: 0.55; letter-spacing: 0; text-transform: uppercase; color: #ffffff; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.25); padding: 16px 22px; border-radius: 999px">Sydney · 12–14 January 2027</span>
<div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 14px; padding-top: 6px">
<a class="shs-btn" href={urls.sheHacksSwiftRegister} target="_blank" rel="noopener noreferrer" style="display: inline-block; text-decoration: none; font-family: 'Jen Wagner Print', sans-serif; font-weight: 400; font-size: 32px; line-height: 0.55; letter-spacing: 0; text-transform: uppercase; padding: 12px 26px; border-radius: 999px; white-space: nowrap; background-image: linear-gradient(135deg, #F05138 0%, #D2342A 100%); color: #ffffff">Sign up</a>
<a class="shs-btn shs-btn-linedark" href="#mentors" style="display: inline-block; text-decoration: none; font-family: 'Jen Wagner Print', sans-serif; font-weight: 400; font-size: 32px; line-height: 0.55; letter-spacing: 0; text-transform: uppercase; padding: 12px 26px; border-radius: 999px; white-space: nowrap; border: 2px solid rgba(255, 255, 255, 0.85); color: #ffffff">Swift developer? Mentor with us</a>
</div>
<p style="margin: 0; max-width: 30em; font-size: 15px; line-height: 1.5; font-weight: 500; color: #CFC3EA">Takes about five minutes. Sign up yourself: a parent or guardian only fills in a form if you’re offered a place.</p>
</div>
<div style="width: 100vw; margin-left: calc(50% - 50vw); display: flex; flex-direction: column; gap: 16px; padding-top: clamp(12px, 2vw, 28px)">
<div class="shs-strip"><div class="shs-track"><img src="/images/shehacksswift/photo-S61.webp" alt="Five students flexing in front of Girl Geek Academy banners" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M43.webp" alt="Four students on a bench, each with her own laptop" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S02.webp" alt="Two students smiling together" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M26.webp" alt="Two students posing in front of a colourful mural" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S66.webp" alt="Two students holding a SheHacksSwift sign" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M65.webp" alt="Three students working on laptops at a table" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S40.webp" alt="Three students posing in front of Girl Geek Academy banners" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S61.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M43.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S02.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M26.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S66.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M65.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S40.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"></div></div>
<div class="shs-strip"><div class="shs-track shs-rev"><img src="/images/shehacksswift/photo-M14.webp" alt="Three students posing and waving" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S13.webp" alt="Two students laughing over a laptop" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M18.webp" alt="Two students with their arms around each other" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S68.webp" alt="Three students holding up signs, one reading SheHacksSwift" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M41.webp" alt="Two students on a bench, each with her own device" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S57.webp" alt="Three students smiling at the camera" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M49.webp" alt="Students holding up their laptops" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M14.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S13.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M18.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S68.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M41.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-S57.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"><img src="/images/shehacksswift/photo-M49.webp" alt="" aria-hidden="true" width="720" height="480" style="display: block; height: clamp(170px, 17vw, 250px); width: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 20px; margin-right: 16px; flex: 0 0 auto"></div></div>
</div>
</div>
<div class="shs-rib shs-rib1" aria-hidden="true" style="position: absolute; left: -6%; right: -6%; bottom: 0; z-index: 4; pointer-events: none; transform: translateY(50%)"><div class="shs-swoop" style="display: block; width: 92%; margin: 0 auto; aspect-ratio: 2048 / 687; background: url('/images/shehacksswift/swift-org/section-swoop-0.png') no-repeat center / 100% 100%; transform: translateY(-80px)"></div></div>
</section>
<section id="how" aria-labelledby="shs-how" class="shs-g shs-d" style="position: relative; z-index: 7; background-image: linear-gradient(180deg, #ffffff 0%, #e6f6ff 28%, #d9f2ff 62%, #fff3d8 100%); color: #1B1530; padding: clamp(110px, 12vw, 180px) 20px clamp(110px, 12vw, 180px)">
<div style="position: relative; z-index: 3; max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(36px, 4.5vw, 56px)">
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 40px 56px">
<div style="flex: 999 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<h2 id="shs-how" style="margin: 0; font-family: 'Piñata LimesSans-Black', sans-serif; font-weight: 400; font-size: clamp(38px, 5vw, 64px); line-height: 1.0; letter-spacing: 0.02em; text-wrap: balance; text-align: left; color: #1B1530; text-transform: uppercase">How it works</h2>
<p style="margin: 0; max-width: 38em; font-size: clamp(19px, 1.6vw, 22px); line-height: 1.5; color: #3B3552">Swift is the programming language used to create apps for Apple devices. You’ll leave with your own app playground: a small, working app that someone can explore in about three minutes. It’s the format the Swift Student Challenge asks for.</p>
<p style="margin: 0; max-width: 38em; font-size: clamp(19px, 1.6vw, 22px); line-height: 1.5; color: #3B3552">Each day follows the steps app designers use: find the problem, build and test, then polish.</p>
</div>
