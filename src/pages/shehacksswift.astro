---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailCta from '../components/EmailCta.astro';
import VideoGallery from '../components/VideoGallery.astro';
import { workExperienceVideos } from '../data/videos';
import { urls } from '../data/urls';
import { Image } from 'astro:assets';
import { lib } from '../data/library';

const days = [
	{
		day: 'Day 1',
		title: 'Introductions & Kickoff',
		description: 'Meet the group, Swift refresher, and start planning your own app.',
	},
	{
		day: 'Day 2',
		title: 'Build & Test',
		description:
			'Build your app with mentors on hand. Your crew tests it and gives feedback, but every app is your own work.',
	},
	{
		day: 'Day 3',
		title: 'App Prep & Celebration',
		description:
			"Polish your app, demo it to the room and celebrate. You'll leave with your own app playground to keep working on for the Challenge.",
	},
];

const cities = [{ city: 'Sydney', dates: '12–14 January 2027', venue: 'Sydney' }];

const faqs = [
	{
		q: 'Do I need experience with Swift or coding?',
		a: 'No prior experience is required. Pre-work online workshops will get you ready before Day 1.',
	},
	{
		q: 'What do I need to bring?',
		a: 'One device per participant (Mac or iPad), your lunch, and a willingness to learn! Apps are built in Swift Playground or Xcode, which run on Mac and iPad.',
	},
	{
		q: 'What are the hours?',
		a: 'Sessions run 9:30am–4:00pm each day.',
	},
	{
		q: 'Who can apply?',
		a: 'Girls and gender-diverse students, including non-binary students, at high school in Australia who will be 13 or older by February 2027 and can get to Sydney for all three days.',
	},
	{
		q: 'Can I work with my friends?',
		a: "Yes. You'll be in a crew of 4 to 6 for ideas, testing and demos. Swift Student Challenge entries are individual, though, so everyone builds and submits their own app playground. Mentors coach and explain but never type in your project.",
	},
	{
		q: 'Do my parents need to do anything?',
		a: "Not to sign up. You can do that yourself. If you're offered a place, a parent or guardian fills in a short form and the consent forms within 7 days to confirm it.",
	},
	{
		q: "What's the Swift Student Challenge?",
		a: "Apple's annual coding challenge for students. Each entrant builds their own app playground in Swift. SheHacksSwift gets you ready to enter in early 2027.",
	},
];
---

<Layout
	title="SheHacksSwift — Girl Geek Academy"
	description="Free 3-day work experience program where high school girls and gender-diverse students learn Swift and build apps for Apple devices. Sydney, 12–14 January 2027."
	bodyClass="page-shehacksswift"
>
	<Header />
	<main>

		<!-- Hero -->
		<section class="swift-hero section">
			<div class="container grid-2">
				<div>
					<p class="page-eyebrow">Free Work Experience</p>
					<h1>SheHacksSwift</h1>
					<div class="lead-row">
						<p class="lead">
							A free 3-day program where high school girls and gender-diverse students learn Swift and each
							build their own app, ready to enter the{' '}
							<a
								href="https://developer.apple.com/swift-student-challenge/"
								target="_blank"
								rel="noopener noreferrer">Swift Student Challenge</a
							>{' '}
							in early 2027. Next up: Sydney, 12–14 January 2027.
						</p>
						<Image
							src={lib('graphics/Untitled-design2.png')}
							alt="Swift"
							width={191}
							height={59}
							class="swift-mark"
						/>
					</div>
					<div class="swift-hero__locations">
						{
							cities.map((c) => (
								<div class="location-chip">
									<strong>{c.city}</strong> — {c.dates}
								</div>
							))
						}
					</div>
					<a
						class="btn btn-primary"
						href={urls.sheHacksSwiftRegister}
						target="_blank"
						rel="noopener noreferrer">Sign up</a
					>
					<p class="hero-note">
						Takes about five minutes. Sign up yourself: a parent or guardian only fills in a form if
						you're offered a place.
					</p>
				</div>
				<div class="hero-media hero-media--wide">
					<Image src={lib('photos/High-school.jpeg')} alt="High school girls laughing together at their computers during a Girl Geek Academy program" width={900} />
				</div>
			</div>
		</section>

		<!-- Program structure -->
		<section class="section section--dark swift-deep">
			<div class="container">
				<h2 class="text-center">How it works</h2>
				<div class="grid-3 days-grid">
					{
						days.map((d) => (
							<div class="day-card">
								<p class="day-label">{d.day}</p>
								<h4>{d.title}</h4>
								<p>{d.description}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<VideoGallery
			class="swift-videos"
			heading="Holiday programs"
			intro="School-holiday delivery for high school girl geeks."
			videos={workExperienceVideos}
		/>

		<!-- Details -->
		<section class="section details-section">
			<div class="container grid-2">
				<div>
					<h2>What you need to know</h2>
					<ul class="details-list">
						<li><strong>Cost:</strong> Free</li>
						<li>
							<strong>Who:</strong> Girls and gender-diverse students at high school in Australia,
							including non-binary students, who can come to Sydney all three days
						</li>
						<li><strong>Hours:</strong> 9:30am–4:00pm each day</li>
						<li><strong>Bring:</strong> One device (Mac or iPad) and your lunch</li>
						<li>
							<strong>Pre-work:</strong> Online workshops before the event to get you ready
						</li>
					</ul>
					<p>
						No prior coding experience needed — just enthusiasm for technology and a willingness to
						build something new.
					</p>
				</div>
				<div class="cities-grid">
					{
						cities.map((c) => (
							<div class="city-card">
								<h4>{c.city}</h4>
								<p>{c.dates}</p>
								<a
									class="btn btn-primary"
									href={urls.sheHacksSwiftRegister}
									target="_blank"
									rel="noopener noreferrer">Sign up</a
								>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- FAQ -->
		<section class="section faq-section">
			<div class="container">
				<h2 class="text-center">Frequently asked questions</h2>
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<div class="faq-item">
								<p class="faq-q">{faq.q}</p>
								<p class="faq-a">{faq.a}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Mentors -->
		<section class="section mentor-section">
			<div class="container">
				<h2 class="text-center">Swift developer? Mentor with us</h2>
				<div class="mentor-copy">
					<p>We need Swift and iOS developers to:</p>
					<ul class="mentor-list">
						<li>Mentor in the room in Sydney, 12–14 January (full or half days)</li>
						<li>Give a 15-minute “how I got into iOS” talk on Day 1</li>
						<li>Sit on the Day 3 showcase feedback panel</li>
						<li>Mentor online from any city, about an hour a week through January and February</li>
					</ul>
					<p>
						Mentors need a Working With Children Check (free for NSW volunteers) and join a one-hour
						online onboarding in December. Mentors coach and explain but never type in a student's
						project.
					</p>
					<a
						class="btn btn-primary"
						href={urls.sheHacksSwiftMentor}
						target="_blank"
						rel="noopener noreferrer">Become a mentor</a
					>
				</div>
			</div>
		</section>

		<!-- Educators CTA -->
		<section class="section section--dark swift-deep text-center">
			<div class="container">
				<h2>Are you a teacher or parent?</h2>
				<p>
					Share this page with the girl geeks you know. For questions, or to bring SheHacksSwift to
					your school or city, email hello@girlgeekacademy.com.
				</p>
				<div class="edu-ctas">
					<a
						class="btn btn-yellow"
						href={urls.sheHacksSwiftRegister}
						target="_blank"
						rel="noopener noreferrer">Sign up</a
					>
					<EmailCta label="Bring SheHacksSwift to your city" variant="coral" />
				</div>
				<p class="swift-trademark">Swift and the Swift logo are trademarks of Apple Inc.</p>
			</div>
		</section>

	</main>
	<Footer />
</Layout>

<style>
	.poster-link {
		display: inline-block;
		margin: 0.5rem auto 1.5rem;
	}

	.poster-link img {
		height: auto;
		border-radius: 0.25rem;
		box-shadow: 4px 3px 0 0 var(--color-yellow-light);
	}

	.swift-hero {
		background-color: var(--color-mint);
		color: var(--color-dark);
		padding-bottom: 4rem;
	}

	.swift-hero h1,
	.page-eyebrow,
	.location-chip,
	.lead a,
	.lead a:hover {
		color: var(--color-primary-hover);
	}

	.page-eyebrow {
		font-family: var(--font-pinata);
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin: 0 0 0.5rem;
	}

	.lead-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.lead {
		font-size: 1.125rem;
		max-width: 60ch;
		margin-bottom: 0;
		flex: 1 1 16rem;
	}

	.lead a {
		text-decoration: underline;
	}

	.swift-mark {
		width: 6.5rem;
		height: auto;
		flex: 0 0 auto;
	}

	@media (max-width: 640px) {
		.lead-row {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	.hero-note {
		font-size: 0.9rem;
		margin: 0.75rem 0 0;
		max-width: 36rem;
	}

	.swift-hero__locations {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 1.5rem;
	}

	.location-chip {
		background: var(--color-white);
		border-radius: 2rem;
		padding: 0.4rem 1rem;
		font-size: 0.95rem;
	}

	/* White on the default primary blue is 3.89:1. Button type is 20px at the
	   small end of the clamp, so it needs 4.5:1. */
	a.btn-primary {
		color: var(--color-white);
		background-color: var(--color-primary-hover);
		border-color: var(--color-primary-hover);
	}

	a.btn-primary:hover,
	a.btn-primary:focus-visible {
		color: var(--color-white);
		background-color: color-mix(in srgb, var(--color-primary-hover) 78%, black);
		border-color: color-mix(in srgb, var(--color-primary-hover) 78%, black);
	}

	/* section--dark forces anchor color to white, which fails on yellow. */
	.swift-deep a.btn-yellow,
	.swift-deep a.btn-yellow:hover,
	.swift-deep a.btn-yellow:focus-visible {
		color: var(--color-dark);
	}

	/* Days */
	.swift-deep {
		background-color: var(--color-primary-hover);
	}

	.days-grid {
		margin-top: 2rem;
	}

	.day-card {
		background: rgba(255, 255, 255, 0.1);
		border-radius: 0.5rem;
		padding: 1.5rem;
	}

	.day-label {
		font-family: var(--font-pinata);
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-yellow);
		margin: 0 0 0.5rem;
	}

	.day-card h4 {
		color: var(--color-white);
		font-size: clamp(1.25rem, 2.5vw, 1.75rem);
		margin-bottom: 0.75rem;
	}

	.day-card p {
		color: var(--color-white);
		margin: 0;
	}

	/* .day-card p is more specific than .day-label, so set the label color again. */
	.day-card .day-label {
		color: var(--color-yellow);
	}

	/* Details */
	.details-section {
		background: var(--color-yellow-light);
		color: var(--color-dark);
	}

	.details-section h2,
	.city-card h4 {
		color: var(--color-primary-hover);
	}

	.details-list {
		padding-left: 1.25rem;
		margin-bottom: 1.5rem;
	}

	.details-list li {
		margin-bottom: 0.6rem;
	}

	.cities-grid {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.city-card {
		background: var(--color-white);
		border-radius: 0.5rem;
		padding: 1.5rem;
		border-left: 4px solid var(--color-primary);
	}

	.city-card h4 {
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		margin-bottom: 0.25rem;
	}

	.city-card p {
		color: var(--color-dark);
		margin-bottom: 1rem;
	}

	/* FAQ */
	.faq-section {
		background: var(--color-white);
	}

	.faq-list {
		max-width: 720px;
		margin: 2rem auto 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.faq-item {
		background: var(--color-yellow-light);
		border-radius: 0.5rem;
		padding: 1.25rem 1.5rem;
	}

	.faq-q {
		font-weight: 600;
		color: var(--color-primary-hover);
		margin: 0 0 0.5rem;
	}

	.faq-a {
		margin: 0;
		color: var(--color-dark);
	}

	/* Mentors */
	.mentor-section {
		background: var(--color-yellow-light);
		color: var(--color-dark);
	}

	.mentor-section h2 {
		color: var(--color-primary-hover);
	}

	.mentor-copy {
		max-width: 40rem;
		margin: 1.5rem auto 0;
	}

	.mentor-list {
		padding-left: 1.25rem;
		margin: 0 0 1.5rem;
	}

	.mentor-list li {
		margin-bottom: 0.6rem;
	}

	.mentor-copy .btn {
		margin-top: 0.5rem;
	}

	/* Educator CTA */
	.edu-ctas {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.swift-trademark {
		font-size: 0.75rem;
		line-height: 1.4;
		margin: 2.5rem 0 0;
	}

	/* Holiday-programs intro and captions inherit the site blue (#5f7dd7 on white is 3.89:1). */
	:global(.swift-videos) {
		color: var(--color-dark);
	}

	/* Shared chrome on this page: nav blue and footer white-on-primary are under 4.5:1. */
	:global(.page-shehacksswift .header__link),
	:global(.page-shehacksswift .header__dropdown-link) {
		color: var(--color-primary-hover);
	}

	:global(.page-shehacksswift .header__link:hover),
	:global(.page-shehacksswift .header__link:focus-visible),
	:global(.page-shehacksswift .header__dropdown-link:hover),
	:global(.page-shehacksswift .header__dropdown-link:focus-visible) {
		color: var(--color-primary-hover);
		text-decoration: underline;
	}

	:global(.page-shehacksswift .header .btn-primary) {
		color: var(--color-white);
		background-color: var(--color-primary-hover);
		border-color: var(--color-primary-hover);
	}

	:global(.page-shehacksswift .header .btn-primary:hover),
	:global(.page-shehacksswift .header .btn-primary:focus-visible) {
		color: var(--color-white);
		background-color: color-mix(in srgb, var(--color-primary-hover) 78%, black);
		border-color: color-mix(in srgb, var(--color-primary-hover) 78%, black);
	}

	:global(.page-shehacksswift .footer.section--dark) {
		background: var(--color-primary-hover);
	}

	:global(.page-shehacksswift .footer__wave path) {
		fill: var(--color-primary-hover);
	}

	/* Kit embed uses black checkbox text and a pale blue Subscribe button. */
	:global(.page-shehacksswift .footer .formkit-checkboxes),
	:global(.page-shehacksswift .footer .formkit-form label) {
		color: var(--color-white) !important;
	}

	:global(.page-shehacksswift .footer .formkit-submit) {
		color: var(--color-primary-hover) !important;
		background-color: var(--color-white) !important;
	}
</style>
