---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmailCta from '../components/EmailCta.astro';
import VideoGallery from '../components/VideoGallery.astro';
import { urls } from '../data/urls';
import { aboutVideos } from '../data/videos';

const founders = [
	{
		name: 'Sarah Moran',
		role: 'Co-founder & CEO',
		bio: 'Sarah learned to code when she was five and got pushed out of tech in Year 10 (her teacher didn’t understand the code behind her website — despite it being very excellent). She gets angry when women and girls who are good at tech get pushed out, so she fights to stop it happening to others. Winner of The Australian Women’s Weekly Women of the Future (2018) — then a judge — a UN Women Australia speaker, and a regular technology commentator on The Today Show. Telling the Girl Geek Academy story, finding great people to work with, and making sure there’s always money in the bank is her job as CEO.',
	},
	{
		name: 'Lisy Kane',
		role: 'Co-founder & games producer',
		bio: 'Lisy is a videogames producer with a global footprint — the only Australian on Forbes 30 Under 30: Games (2017). At Melbourne studio League of Geeks her work includes award-winning title Armello; she oversees international releases across Steam, PlayStation, Xbox, Switch and mobile. She’s in high demand on the speaker circuit for gaming, tech and STEM education — including for NASA — and can often be found streaming DOTA 2 on Twitch.',
	},
	{
		name: 'Tammy Butow',
		role: 'Co-founder & Empress of Chaos',
		bio: 'Tammy has the coolest job of anyone you’ll ever meet — breaking things on purpose by running chaos experiments, which earned her the nickname Empress of Chaos. Based in Florida after San Francisco, she’s VP of Reliability at Gremlin. She started at 10, building and fixing computers and ridding family friends’ machines of viruses. As a Site Reliability Engineer she’s kept the lights on at places like Dropbox, DigitalOcean and NAB. Tammy sat the five of us down in 2014 and said: you’re awesome, you’re awesome, you’re awesome and you’re awesome — we’re starting a company.',
	},
	{
		name: 'Amanda Watts',
		role: 'Co-founder & chief hipster',
		bio: 'Using the keyboard as her paintbrush, Amanda is the artist behind Girl Geek Academy’s vibrant branding — from pixels to paint. She owns marketing and branding agency Design Junkies (10+ years) and co-founded a startup with a fellow founder she met at the first #SheHacks in 2014.',
	},
	{
		name: 'April Staines',
		role: 'Co-founder & chief maker',
		bio: 'April was a geek before geek was even a word. She runs April Storm Props — digitally fabricated and 3D-printed costume props for fans and cosplay — and even built her own working droid, R2-QT. When she outgrew her home with printers, she moved to a farm: unlike most farmers, she gets up to turn on her 16 3D printers before her day job as a distinguished engineer at NAB. She co-authored Girl Geeks: Making Magic to inspire girls into space and making.',
	},
];

const impact = [
	{ value: '1000+', label: 'teachers taught to code' },
	{ value: '12,000+', label: 'kids introduced to STEM education' },
	{ value: '32,000+', label: 'books sold in Australia alone' },
	{ value: '46', label: 'official company teapots' },
];

const pipeline = [
	{ age: 'By age 6', fact: 'Children classify jobs as male and female.' },
	{ age: 'By age 8', fact: 'They are limiting aspirations.' },
	{ age: 'By 13', fact: 'They rule out careers that don’t fit gender stereotypes.' },
	{ age: 'By 16–17', fact: 'Around 60% of girls aspire to stereotypically “female” jobs.' },
];
---

<Layout
	title="About Us — Girl Geek Academy"
	description="Get ya geek on. Tech has a pipeline problem — so we’re fixing the holes in the pipe. Meet the founders of Girl Geek Academy and how we accidentally ran the world’s first all-women hackathon."
>
	<Header />
	<main>
		<section class="about-hero section">
			<div class="container">
				<p class="about-hero__eyebrow">About us</p>
				<h1>Get ya geek on!</h1>
				<p class="about-hero__lead">
					<strong>Tech has a pipeline problem — so we’re fixing the holes in the pipe.</strong>
				</p>
				<p>
					Women and girls shape the technology that shapes their lives. We ran the world’s first
					all-women hackathon in 2014. Then we realised: if we’d started teaching children 10 years
					ago, we could be hiring them today.
				</p>
				<p>
					So now our programs teach women, girls and families across games, startups, 3D printing,
					design, software, hardware, AI, space, aviation and robotics — and we partner with teachers,
					parents, corporates and governments to keep girl geeks in.
				</p>
				<div class="about-hero__ctas">
					<a href={urls.workWithUs} class="btn btn-primary">Work with Us</a>
					<a href={urls.report} class="btn btn-coral">Research & Impact</a>
				</div>
			</div>
		</section>

		<section class="about-origin section section--dark">
			<div class="container">
				<p class="about-origin__eyebrow">Our girl gang · 2014</p>
				<h2>We accidentally ran the first all-women hackathon in the world</h2>
				<div class="grid-2 about-origin__grid">
					<div>
						<p>
							We were going to tech events, but they were usually held in dark basements where they
							fed us beer, pizza and energy drinks. (We like those things — but we have our limits.)
							Our mates were happy we came, but they’d ask: “Why don’t more girls come to our
							events?”
						</p>
						<p>
							So we designed a hackathon <em>we</em> wanted to go to — as an example of how great
							tech events can be. We had tea and cupcakes. And yoga. And sunlight! We ran the first
							#SheHacks for International Women’s Day 2014.
						</p>
					</div>
					<div>
						<p>
							We tried to find other women and non-binary folk running similar hackathons so we
							could be their friends. We looked and looked — and realised no one had run one before.
							We’d accidentally run the first all-women hackathon in the world.
						</p>
						<p>
							We thought: if no one has done this very basic thing to support us, who’s working on
							the hard stuff? That’s when we knew we had a responsibility to do so. In July 2014 we
							founded Girl Geek Academy as a company and a global movement — and we’ve been building
							a world where tech isn’t just a boy’s club ever since.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="about-pipeline section">
			<div class="container">
				<h2 class="text-center">Tech has a pipeline problem</h2>
				<p class="text-center about-pipeline__intro">Let’s talk about the holes in the pipe.</p>
				<div class="about-pipeline__grid">
					{
						pipeline.map((s) => (
							<div class="about-pipeline__card">
								<p class="about-pipeline__age">{s.age}</p>
								<p>{s.fact}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="about-impact section section--dark">
			<div class="container">
				<h2 class="text-center">Gender inequality ain’t gonna fix itself</h2>
				<p class="text-center about-impact__intro">
					Since we launched, we’ve achieved more than we could have imagined — including:
				</p>
				<div class="about-impact__stats">
					{
						impact.map((n) => (
							<div class="about-impact__stat">
								<span class="about-impact__value">{n.value}</span>
								<span class="about-impact__label">{n.label}</span>
							</div>
						))
					}
				</div>
				<p class="text-center about-impact__more">
					Through grants, tenders, corporate clients and fundraising, we’ve prototyped what works —
					and campaigned in media for change. Today we’re on our way to one million friends: a true
					community with global reach.
				</p>
			</div>
		</section>

		<section id="team" class="about-founders section">
			<div class="container">
				<h2 class="text-center">Meet Amanda, Lisy, Tammy, Sarah & April</h2>
				<p class="text-center about-founders__intro">Say g’day to our girl gang founders.</p>
				<ul class="about-founders__list">
					{
						founders.map((f) => (
							<li class="about-founders__card">
								<p class="about-founders__name">{f.name}</p>
								<p class="about-founders__role">{f.role}</p>
								<p class="about-founders__bio">{f.bio}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<VideoGallery
			id="as-seen"
			heading="As seen on…"
			intro="TV and radio — including ABC Breakfast, ABC News, ABC Pacific (Beyond Awesome), Download This Show, The Project, Scope and The Today Show."
			videos={aboutVideos}
			dark
		/>

		<section class="about-programs section">
			<div class="container text-center">
				<h2>Get ya geek on with us</h2>
				<p>
					From MissMakesCode workshops to #SheHacks and beyond — explore our programs, or partner with
					us to bring them to your school, workplace or community.
				</p>
				<div class="about-programs__links">
					<a href={urls.missMakesCode} class="btn btn-yellow">MissMakesCode</a>
					<a href={urls.sheHacks} class="btn btn-coral">SheHacks</a>
					<a href={urls.workWithUs} class="btn btn-mint">Work with Us</a>
					<EmailCta label="Partner with us for 2027" variant="primary" />
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.about-hero {
		background: linear-gradient(180deg, var(--color-yellow-light) 0%, var(--color-white) 100%);
	}

	.about-hero__eyebrow,
	.about-origin__eyebrow {
		font-family: var(--font-pinata);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin: 0 0 0.75rem;
	}

	.about-origin__eyebrow {
		color: var(--color-yellow);
	}

	.about-hero__lead {
		font-size: 1.25rem;
		max-width: 40rem;
	}

	.about-hero__ctas,
	.about-programs__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	.about-programs__links {
		justify-content: center;
	}

	.about-origin__grid {
		align-items: start;
		margin-top: 1.5rem;
	}

	.about-pipeline__intro,
	.about-impact__intro,
	.about-founders__intro {
		max-width: 36rem;
		margin: 0 auto 2rem;
	}

	.about-pipeline__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	.about-pipeline__card {
		padding: 1.25rem;
		border: 1px solid rgba(95, 125, 215, 0.25);
		border-radius: 0.25rem;
	}

	.about-pipeline__age {
		font-family: var(--font-pinata);
		text-transform: uppercase;
		margin: 0 0 0.5rem;
		color: var(--color-coral);
	}

	.about-pipeline__card p:last-child {
		margin: 0;
	}

	.about-impact__stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		text-align: center;
		margin-bottom: 2rem;
	}

	.about-impact__value {
		display: block;
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1;
		color: var(--color-yellow);
		margin-bottom: 0.35rem;
	}

	.about-impact__label {
		font-size: 0.95rem;
	}

	.about-impact__more {
		max-width: 40rem;
		margin: 0 auto;
	}

	.about-founders__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
	}

	.about-founders__card {
		padding: 1.5rem;
		border: 1px solid rgba(95, 125, 215, 0.2);
		border-radius: 0.25rem;
	}

	.about-founders__name {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		line-height: 1;
		margin: 0 0 0.35rem;
	}

	.about-founders__role {
		font-family: var(--font-pinata);
		text-transform: uppercase;
		font-size: 0.85rem;
		margin: 0 0 0.75rem;
		color: var(--color-coral);
	}

	.about-founders__bio {
		margin: 0;
	}

	@media (max-width: 991px) {
		.about-pipeline__grid,
		.about-impact__stats {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
