---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { formatNewsDate, getNewsPosts, newsCategoryUrl } from '../../data/news';
import { urls } from '../../data/urls';

export const getStaticPaths = (async () => {
	const posts = await getNewsPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, category, excerpt, heroImage, heroAlt } = post.data;
---

<Layout title={`${title} — Girl Geek Academy`} description={excerpt}>
	<Header />
	<main>
		<article>
			<header class="section post-hero">
				<div class="container post-container">
					<p class="post-hero__meta">
						<a href={newsCategoryUrl(category)}>{category}</a>
						<time datetime={date.toISOString()}>{formatNewsDate(date)}</time>
					</p>
					<h1 class="post-hero__title">{title}</h1>
				</div>
			</header>
			{
				heroImage && (
					<div class="container post-container">
						<Image class="post-hero__image" src={heroImage} alt={heroAlt} width={1200} />
					</div>
				)
			}
			<div class="section post-body-section">
				<div class="container post-container post-body">
					<Content />
				</div>
				<div class="container post-container">
					<a class="post-back" href={urls.news}>← All news</a>
				</div>
			</div>
		</article>
	</main>
	<Footer />
</Layout>

<style>
	.post-container {
		max-width: 46rem;
	}

	.post-hero {
		background: linear-gradient(180deg, var(--color-yellow-light) 0%, var(--color-white) 100%);
		padding-bottom: 1.5rem;
	}

	.post-hero__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0 0 1rem;
		font-family: var(--font-pinata);
		text-transform: uppercase;
	}

	.post-hero__title {
		font-size: clamp(2.25rem, 5vw, 3.75rem);
		line-height: 0.95;
		margin: 0;
	}

	.post-hero__image {
		width: 100%;
		height: auto;
		border-radius: 0.25rem;
	}

	.post-body-section {
		padding-top: 2rem;
	}

	.post-body {
		color: var(--color-dark);
		font-size: 1.0625rem;
		overflow-wrap: break-word;
	}

	.post-body :global(h2),
	.post-body :global(h3),
	.post-body :global(h4),
	.post-body :global(h5),
	.post-body :global(h6) {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 1.375rem;
		line-height: 1.3;
		text-transform: none;
		letter-spacing: 0;
		color: var(--color-primary);
		margin: 2rem 0 0.75rem;
	}

	.post-body :global(h2) {
		font-size: 1.625rem;
	}

	.post-body :global(a) {
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.post-body :global(img) {
		border-radius: 0.25rem;
		margin: 1.5rem 0;
	}

	.post-body :global(blockquote) {
		margin: 1.5rem 0;
		padding: 0.75rem 1.25rem;
		border-left: 4px solid var(--color-mint);
		background: var(--color-yellow-light);
		border-radius: 0 0.25rem 0.25rem 0;
	}

	.post-body :global(blockquote p) {
		margin: 0.25rem 0;
	}

	.post-body :global(.video) {
		position: relative;
		aspect-ratio: 16 / 9;
		margin: 1.5rem 0;
		border-radius: 0.25rem;
		overflow: hidden;
	}

	.post-body :global(.video iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.post-back {
		display: inline-block;
		margin-top: 2rem;
		font-weight: 600;
	}
</style>
