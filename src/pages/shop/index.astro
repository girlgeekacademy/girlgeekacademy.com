---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import beanieImg from '../../assets/shop/beanie.jpg';
import booksImg from '../../assets/shop/books-boxed-set.jpg';
import { urls } from '../../data/urls';
import { products, shippingRates, formatAud } from '../../data/shop';

const images = {
	beanie: beanieImg,
	books: booksImg,
} as const;
---

<Layout
	title="Shop — Girl Geek Academy"
	description="Shop Girl Geek Academy merch — beanies and the Girl Geeks book series. Australia $5 shipping, international $20."
>
	<Header />
	<main>
		<section class="shop-hero section">
			<div class="container">
				<p class="shop-hero__eyebrow">Shop</p>
				<h1>Books and beanies</h1>
				<p class="shop-hero__lead">
					Support Girl Geek Academy and get ya geek on. Flat-rate shipping —
					{formatAud(shippingRates.australia.amount)} in Australia,{' '}
					{formatAud(shippingRates.international.amount)} international.
				</p>
			</div>
		</section>

		<section class="section shop-products">
			<div class="container shop-products__grid">
				{
					products.map((product) => {
						const img = images[product.id as keyof typeof images];
						const checkoutReady = Boolean(product.paymentLink);
						return (
							<article class="product" id={product.id}>
								<div class="product__media">
									{img && (
										<Image
											src={img}
											alt={product.name}
											width={799}
											height={534}
											class="product__image"
										/>
									)}
								</div>
								<div class="product__body">
									<h2 class="product__title">{product.name}</h2>
									<p class="product__price">{formatAud(product.price)}</p>
									<p class="product__desc">{product.description}</p>
									<ul class="product__shipping">
										<li>
											{shippingRates.australia.label}:{' '}
											{formatAud(shippingRates.australia.amount)}
										</li>
										<li>
											{shippingRates.international.label}:{' '}
											{formatAud(shippingRates.international.amount)}
										</li>
									</ul>
									{checkoutReady ? (
										<a
											href={product.paymentLink}
											class="btn btn-primary product__buy"
											rel="noopener noreferrer"
										>
											Buy now
										</a>
									) : (
										<a href={urls.email} class="btn btn-primary product__buy">
											Email to order
										</a>
									)}
								</div>
							</article>
						);
					})
				}
			</div>
		</section>

		<section class="section shop-note">
			<div class="container text-center">
				<p>
					Checkout is powered by Stripe. You’ll get an email receipt after payment — no account
					needed. Questions or returns? See our{' '}
					<a href={urls.refundReturns}>refund and returns policy</a>
					{' '}or write to{' '}
					<a href={urls.email}>hello@girlgeekacademy.com</a>.
				</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.shop-hero {
		background:
			radial-gradient(ellipse at 20% 0%, rgba(143, 211, 215, 0.45), transparent 55%),
			radial-gradient(ellipse at 90% 20%, rgba(255, 225, 147, 0.55), transparent 50%),
			linear-gradient(180deg, #fff8e8 0%, var(--color-white) 100%);
	}

	.shop-hero__eyebrow {
		font-family: var(--font-pinata);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin: 0 0 0.75rem;
		color: var(--color-coral);
	}

	.shop-hero h1 {
		margin-bottom: 1rem;
	}

	.shop-hero__lead {
		max-width: 36rem;
		font-size: 1.125rem;
		margin: 0;
	}

	.shop-products {
		padding-top: 0;
	}

	.shop-products__grid {
		display: grid;
		gap: 3rem;
	}

	.product {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 2rem;
		align-items: center;
	}

	.product:nth-child(even) .product__media {
		order: 2;
	}

	.product__media {
		background:
			linear-gradient(135deg, rgba(95, 125, 215, 0.12), rgba(233, 171, 208, 0.18));
		border-radius: 0.5rem;
		overflow: hidden;
		min-height: 240px;
	}

	.product__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 3 / 2;
	}

	.product__title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 0.9;
		margin-bottom: 0.5rem;
	}

	.product__price {
		font-family: var(--font-pinata);
		font-size: 1.5rem;
		color: var(--color-coral);
		margin: 0 0 1rem;
	}

	.product__desc {
		margin: 0 0 1rem;
	}

	.product__shipping {
		margin: 0 0 1.5rem;
		padding-left: 1.25rem;
		color: var(--color-primary);
	}

	.product__buy {
		box-shadow: 4px 3px 0 0 #fff0c9;
	}

	.shop-note {
		background: var(--color-yellow-light);
	}

	.shop-note p {
		max-width: 40rem;
		margin: 0 auto;
	}

	.shop-note a {
		text-decoration: underline;
	}

	@media (max-width: 991px) {
		.product,
		.product:nth-child(even) {
			grid-template-columns: 1fr;
		}

		.product:nth-child(even) .product__media {
			order: 0;
		}
	}
</style>
