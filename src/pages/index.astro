	description="Girls and women who love tech get pushed out of it. Girl Geek Academy keeps girl geeks in, and gives women and girls the power to build, question and govern technology."
>
	<Header />
	<main>
		<Hero />
		<Pipeline />
		<KeepIn />
		<ProgramsHome />
		<ReportSection />
		<TechInSchools />
		<Books />
		<PartnerHome />
	</main>
	<Footer />
</Layout>
