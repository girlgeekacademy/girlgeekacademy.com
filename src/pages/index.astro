---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Pipeline from '../components/home/Pipeline.astro';
import KeepIn from '../components/home/KeepIn.astro';
import ProgramsHome from '../components/home/ProgramsHome.astro';
import ReportSection from '../components/home/ReportSection.astro';
import TechInSchools from '../components/home/TechInSchools.astro';
import Books from '../components/home/Books.astro';
